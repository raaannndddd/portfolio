<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>The kitchen</title>
<style>
  :root{
    --ink:#1c1a17;
    --card:#fffdf9;
    --shadow:0 8px 30px rgba(28,22,14,.20);
    --radius:14px;
  }
  *{box-sizing:border-box}
  html,body{height:100%;width:100%;margin:0;padding:0;background:#0e0c09;overflow:hidden}
  body{
    font-family:"Helvetica Neue",Inter,system-ui,-apple-system,"Segoe UI",sans-serif;
    color:var(--ink);-webkit-font-smoothing:antialiased;
  }
  #stage{position:fixed;inset:0;width:100vw;height:100vh}
  canvas{display:block;width:100%;height:100%;touch-action:none}

  /* lens pass */
  .lens{position:fixed;inset:0;pointer-events:none;z-index:3}
  #vignette{background:radial-gradient(124% 94% at 50% 46%,
      rgba(0,0,0,0) 42%, rgba(34,28,18,.16) 74%, rgba(20,16,10,.44) 100%);}
  #bloom{background:radial-gradient(58% 46% at 50% 4%, rgba(255,236,205,.20), rgba(255,236,205,0) 62%);
         mix-blend-mode:screen;}
  #grain{opacity:.045;mix-blend-mode:overlay;
    background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3'/></filter><rect width='180' height='180' filter='url(%23n)'/></svg>");}

  /* hud */
  .hud{position:fixed;inset:0;pointer-events:none;z-index:5}
  .hud > *{pointer-events:auto}
  .pill{
    position:absolute;background:var(--card);border-radius:var(--radius);
    box-shadow:var(--shadow);border:0;color:var(--ink);
    display:flex;align-items:center;gap:10px;
    font-size:15px;letter-spacing:.01em;font-family:inherit;
    padding:12px 16px;cursor:pointer;
    transition:transform .25s cubic-bezier(.2,.8,.2,1);
  }
  .pill:hover{transform:translateY(-2px)}
  .pill:active{transform:translateY(0)}
  .pill:focus-visible{outline:2px solid #1c1a17;outline-offset:3px}
  .square{padding:12px;width:46px;height:46px;justify-content:center}

  #plaque{top:22px;left:22px;cursor:default}
  #plaque:hover{transform:none}
  #plaque b{font-weight:600}
  #plaque span{color:#8c8375}
  #notes{top:22px;right:22px}
  #sound{bottom:22px;right:22px}
  #full{bottom:22px;right:80px}
  #lights{bottom:22px;left:22px}

  #hint{
    position:absolute;left:50%;bottom:26px;transform:translateX(-50%);
    font-size:11.5px;letter-spacing:.16em;text-transform:uppercase;
    color:#4a4238;text-shadow:0 1px 10px rgba(255,248,232,.7);
    white-space:nowrap;transition:opacity .8s;
  }
  #hint.gone{opacity:0}

  #panel{
    position:absolute;top:80px;right:22px;width:272px;background:var(--card);
    border-radius:var(--radius);box-shadow:var(--shadow);padding:18px 20px;
    opacity:0;transform:translateY(-8px) scale(.98);pointer-events:none;
    transition:opacity .28s, transform .28s cubic-bezier(.2,.8,.2,1);
  }
  #panel.open{opacity:1;transform:none;pointer-events:auto}
  #panel h2{margin:0 0 10px;font-size:11.5px;letter-spacing:.17em;text-transform:uppercase;font-weight:600}
  #panel p{margin:0;font-size:13.5px;line-height:1.55;color:#3c3730}
  #panel dl{margin:14px 0 0;font-size:13px;line-height:1.65;color:#3c3730}
  #panel dt{float:left;clear:left;width:104px;color:#8c8375}
  #panel dd{margin:0 0 0 104px}

  #tag{
    position:absolute;left:0;top:0;transform:translate(-50%,-50%);
    background:var(--card);border-radius:999px;padding:8px 15px;
    font-size:11.5px;letter-spacing:.13em;text-transform:uppercase;
    box-shadow:var(--shadow);opacity:0;transition:opacity .18s;
    pointer-events:none;white-space:nowrap;z-index:6;
  }
  #tag.show{opacity:1}

  #fade{position:fixed;inset:0;background:#0e0c09;z-index:9;
        transition:opacity .8s ease;pointer-events:none}
  #fade.hidden{opacity:0}

  @media (max-width:820px){
    #plaque{top:14px;left:14px;font-size:13px}
    #notes{top:14px;right:14px}
    #sound{bottom:14px;right:14px}#full{bottom:14px;right:70px}
    #lights{bottom:14px;left:14px}
    #panel{right:12px;width:calc(100vw - 24px);max-width:280px}
    #hint{font-size:10px;letter-spacing:.1em;bottom:74px}
  }
  @media (prefers-reduced-motion:reduce){*{transition-duration:.01ms !important}}
</style>
</head>
<body>

<div id="stage"></div>
<div class="lens" id="vignette"></div>
<div class="lens" id="bloom"></div>
<div class="lens" id="grain"></div>

<div class="hud">
  <div class="pill" id="plaque">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#1c1a17" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <rect x="4" y="3" width="16" height="18" rx="2"/><path d="M12 3v18"/><path d="M9.4 7.6v2.6"/><path d="M14.6 7.6v2.6"/>
    </svg>
    <b>The kitchen</b><span>&nbsp;about me</span>
  </div>

  <button class="pill square" id="notes" aria-label="About this room">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1c1a17" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H19v14H6.5A2.5 2.5 0 0 0 4 19.5z"/><path d="M14.5 7.5 19 3"/>
    </svg>
  </button>

  <button class="pill square" id="full" aria-label="Enter fullscreen">
    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#1c1a17" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 9V4h5"/><path d="M20 9V4h-5"/><path d="M4 15v5h5"/><path d="M20 15v5h-5"/>
    </svg>
  </button>

  <button class="pill square" id="sound" aria-label="Turn room tone on">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1c1a17" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <path d="M5 9.5h3.5L13 5.5v13L8.5 14.5H5z"/>
      <path class="wave" d="M16.5 9.5a4 4 0 0 1 0 5"/>
      <path class="wave" d="M19 7a7.5 7.5 0 0 1 0 10"/>
    </svg>
  </button>

  <button class="pill" id="lights">
    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#1c1a17" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 3v1.6"/><path d="M5.6 5.6 6.7 6.7"/><path d="M18.4 5.6 17.3 6.7"/>
      <path d="M8 13.5a4 4 0 1 1 8 0c0 1.7-1.2 2.4-1.5 3.5h-5c-.3-1.1-1.5-1.8-1.5-3.5z"/>
      <path d="M10 20h4"/>
    </svg>
    Lights
  </button>

  <div id="hint">Drag to look · Scroll to step · Click the tap</div>
  <div id="tag"></div>

  <div id="panel">
    <h2>This room</h2>
    <p>Cabinets closed, counters clear. A stainless fridge holds the middle of the back wall, pantry runs either side of it, and the tap is on the left. The right-hand side opens onto the rest of the house.</p>
    <dl>
      <dt>Drag</dt><dd>Look around</dd>
      <dt>Scroll</dt><dd>Step forward and back</dd>
      <dt>Click the tap</dt><dd>Run the water</dd>
      <dt>Click the switch</dt><dd>Ceiling lights</dd>
    </dl>
  </div>
</div>

<div id="fade"></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
(function(){
"use strict";
if(!window.THREE) return;

/* ============================================================
   0. HUD
   ============================================================ */
const panel  = document.getElementById('panel');
const hintEl = document.getElementById('hint');
const tag    = document.getElementById('tag');
const fadeEl = document.getElementById('fade');
const waves  = document.querySelectorAll('.wave');
waves.forEach(function(w){ w.style.opacity = 0.18; });
let hintHidden = false;
function hideHint(){ if(!hintHidden){ hintHidden = true; hintEl.classList.add('gone'); } }

/* ============================================================
   1. PALETTE
   ============================================================ */
/*  >>> EVERY COLOUR IN THE ROOM IS SET HERE. Edit a hex, reload. <<< */
const P = {
  wall:      '#efe7d6',   // plaster above the tiling
  ceiling:   '#f8f4ea',
  trim:      '#e7dfcc',   // cornice, skirting, the casing round the opening

  cabinet:   '#4a615c',   // door and drawer fronts
  cabRail:   '#435853',   // the shaker frame proud of the panel
  carcass:   '#2c3a37',   // cabinet box behind the fronts — barely seen
  toe:       '#25302e',   // recessed kick under the base run

  counter:   '#e3ddce',   // stone worktop
  tile:      '#ece5d5',   // splashback tile
  grout:     '#cdc4af',

  floor:     '#a8825a',   // oak boards

  steel:     '#b9bdc1',   // fridge, sink, tap
  steelDark: '#8b9096',
  brass:     '#c6a463',   // pulls and knobs
  glow:      '#ffeccd'    // what the ceiling fittings throw
};

/* ============================================================
   2. RENDERER / CAMERA
   ============================================================ */
const renderer = new THREE.WebGLRenderer({antialias:true, powerPreference:'high-performance'});
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
renderer.setSize(innerWidth, innerHeight);
renderer.outputEncoding = THREE.sRGBEncoding;
renderer.toneMapping = THREE.ACESFilmicToneMapping;
renderer.toneMappingExposure = 1.0;
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;
document.getElementById('stage').appendChild(renderer.domElement);
const ANISO = renderer.capabilities.getMaxAnisotropy();

const scene = new THREE.Scene();
scene.background = new THREE.Color('#e9e1d1');

/* room shell — these five numbers drive every wall and every run of units */
const BACK_Z = -5.5, FRONT_Z = 5.0, SIDE_X = 3.9, WALL_H = 3.05, WALL_T = 0.16;
const OPEN_Z0 = -3.8, OPEN_Z1 = 0.8, OPEN_H = 2.55;   // the gap in the right wall
const HOME = new THREE.Vector3(0, 1.62, 2.8);

const camera = new THREE.PerspectiveCamera(44, innerWidth/innerHeight, 0.05, 120);
camera.position.copy(HOME);

const H_HALF = 29 * Math.PI/180;                 /* constant horizontal FOV */
function frameCamera(){
  camera.aspect = innerWidth / innerHeight;
  const v = 2 * Math.atan(Math.tan(H_HALF) / camera.aspect) * 180/Math.PI;
  camera.fov = THREE.MathUtils.clamp(v, 26, 58);
  camera.updateProjectionMatrix();
}
frameCamera();

/* ============================================================
   3. TEXTURE FOUNDRY — every surface is drawn to a canvas at load
   ============================================================ */
function cvs(w,h){ const c = document.createElement('canvas'); c.width=w; c.height=h; return c; }
function tex(canvas, rx, ry){
  const t = new THREE.CanvasTexture(canvas);
  t.encoding = THREE.sRGBEncoding;
  t.anisotropy = ANISO;
  if(rx){ t.wrapS = t.wrapT = THREE.RepeatWrapping; t.repeat.set(rx, ry || rx); }
  return t;
}
function shift(hex, dL, dS){
  const c = new THREE.Color(hex), hsl = {};
  c.getHSL(hsl);
  c.setHSL(hsl.h, THREE.MathUtils.clamp(hsl.s + (dS||0), 0, 1),
                  THREE.MathUtils.clamp(hsl.l + dL, 0.02, 0.98));
  return '#' + c.getHexString();
}
function rgba(hex, a){
  const c = new THREE.Color(hex);
  return 'rgba(' + Math.round(c.r*255) + ',' + Math.round(c.g*255) + ',' + Math.round(c.b*255) + ',' + a + ')';
}
function blotch(g, w, h, base, count, spread, alpha){
  for(let i=0;i<count;i++){
    const x = Math.random()*w, y = Math.random()*h;
    const r = (0.04 + Math.random()*0.22) * Math.max(w,h) * spread;
    const c = shift(base, (Math.random()-0.5)*0.10, (Math.random()-0.5)*0.06);
    const grd = g.createRadialGradient(x,y,0,x,y,r);
    grd.addColorStop(0, rgba(c, alpha));
    grd.addColorStop(1, rgba(c, 0));
    g.fillStyle = grd; g.fillRect(x-r, y-r, r*2, r*2);
  }
}
function speckle(g, w, h, count, alpha){
  for(let i=0;i<count;i++){
    g.fillStyle = 'rgba(52,44,30,' + (Math.random()*alpha).toFixed(3) + ')';
    g.fillRect(Math.random()*w, Math.random()*h, 1.6, 1.1);
  }
}
/* linear black gradient, used to bake occlusion into a map */
function ao(g, w, h, x0,y0,x1,y1, a){
  const d = g.createLinearGradient(x0,y0,x1,y1);
  d.addColorStop(0, 'rgba(44,34,20,' + a + ')');
  d.addColorStop(1, 'rgba(44,34,20,0)');
  g.fillStyle = d; g.fillRect(0,0,w,h);
}

function plasterCanvas(w, h, o){
  o = o || {};
  const c = cvs(w,h), g = c.getContext('2d');
  g.fillStyle = P.wall; g.fillRect(0,0,w,h);
  blotch(g, w, h, P.wall, 90, 1.0, 0.5);
  blotch(g, w, h, shift(P.wall,-0.05), 40, 0.5, 0.28);
  g.globalAlpha = 0.032; g.lineCap = 'round';
  for(let i=0;i<64;i++){                                   /* trowel drag */
    g.strokeStyle = shift(P.wall, (Math.random()-0.5)*0.14);
    g.lineWidth = 2 + Math.random()*14;
    const x = Math.random()*w, y = Math.random()*h;
    g.beginPath(); g.moveTo(x,y);
    g.lineTo(x + (Math.random()-0.5)*w*0.28, y + (Math.random()-0.5)*h*0.12); g.stroke();
  }
  g.globalAlpha = 1;
  speckle(g, w, h, Math.round(w*h/1000), 0.04);
  if(o.bottom) ao(g, w, h, 0, h, 0, h*(1-o.bottom), 0.30);
  if(o.top)    ao(g, w, h, 0, 0, 0, h*o.top, 0.16);
  return c;
}

/* painted joinery: primer showing through a laid-off brush coat */
function paintCanvas(w, h, color){
  const c = cvs(w,h), g = c.getContext('2d');
  g.fillStyle = color; g.fillRect(0,0,w,h);
  blotch(g, w, h, color, 24, 0.9, 0.14);
  speckle(g, w, h, Math.round(w*h/900), 0.028);
  g.lineCap = 'round';
  /* laid off with the grain — just enough to break the flat fill, never striped */
  for(let i=0, n=Math.max(46, Math.round(w*h/2800)); i<n; i++){
    g.strokeStyle = shift(color, (Math.random()-0.5)*0.032);
    g.globalAlpha = 0.09 + Math.random()*0.14;
    g.lineWidth = 5 + Math.random()*18;
    const y = Math.random()*h;
    g.beginPath(); g.moveTo(-10, y);
    g.bezierCurveTo(w*0.3, y+(Math.random()-0.5)*5, w*0.7, y+(Math.random()-0.5)*5, w+10, y+(Math.random()-0.5)*4);
    g.stroke();
  }
  g.globalAlpha = 1;
  return c;
}

/* wide oak boards, laid across the run */
function floorCanvas(){
  const w = 1024, h = 1024, c = cvs(w,h), g = c.getContext('2d');
  g.fillStyle = P.floor; g.fillRect(0,0,w,h);
  const boards = 6, bh = h/boards;
  for(let b=0;b<boards;b++){
    const y0 = b*bh;
    const tone = shift(P.floor, (Math.random()-0.5)*0.075, (Math.random()-0.5)*0.05);
    g.fillStyle = tone; g.fillRect(0, y0, w, bh);
    /* grain */
    for(let i=0;i<90;i++){
      g.strokeStyle = shift(tone, (Math.random()-0.55)*0.14);
      g.globalAlpha = 0.10 + Math.random()*0.28;
      g.lineWidth = 0.6 + Math.random()*2.6;
      const y = y0 + Math.random()*bh;
      g.beginPath(); g.moveTo(0,y);
      g.bezierCurveTo(w*0.3, y+(Math.random()-0.5)*16, w*0.7, y+(Math.random()-0.5)*16, w, y+(Math.random()-0.5)*9);
      g.stroke();
    }
    /* the odd knot */
    if(Math.random() < 0.55){
      const kx = Math.random()*w, ky = y0 + bh*(0.25+Math.random()*0.5), kr = 5+Math.random()*9;
      g.globalAlpha = 0.5;
      for(let r=kr;r>0;r-=1.6){
        g.strokeStyle = shift(tone, -0.10 - r*0.004);
        g.lineWidth = 1.2;
        g.beginPath(); g.ellipse(kx, ky, r, r*0.55, 0, 0, Math.PI*2); g.stroke();
      }
    }
    g.globalAlpha = 1;
    /* board seam + the shadow that falls into it */
    g.fillStyle = 'rgba(40,26,14,0.34)'; g.fillRect(0, y0, w, 1.6);
    g.fillStyle = 'rgba(255,240,214,0.10)'; g.fillRect(0, y0+1.6, w, 1.2);
    /* butt joints */
    const jx = Math.random()*w;
    g.fillStyle = 'rgba(40,26,14,0.30)'; g.fillRect(jx, y0, 1.5, bh);
  }
  speckle(g, w, h, 2600, 0.05);
  return c;
}

/* honed stone: pale field, fine grit, a couple of lazy veins */
function stoneCanvas(){
  const w = 512, h = 512, c = cvs(w,h), g = c.getContext('2d');
  g.fillStyle = P.counter; g.fillRect(0,0,w,h);
  blotch(g, w, h, P.counter, 44, 0.9, 0.35);
  for(let i=0;i<5;i++){
    g.strokeStyle = 'rgba(120,112,96,' + (0.06+Math.random()*0.09).toFixed(3) + ')';
    g.lineWidth = 1 + Math.random()*4;
    let x = Math.random()*w, y = -10;
    g.beginPath(); g.moveTo(x,y);
    while(y < h+10){ x += (Math.random()-0.5)*70; y += 26+Math.random()*40; g.lineTo(x,y); }
    g.stroke();
  }
  for(let i=0;i<5000;i++){
    g.fillStyle = Math.random()<0.5 ? 'rgba(96,90,78,0.16)' : 'rgba(255,252,244,0.20)';
    g.fillRect(Math.random()*w, Math.random()*h, 1.4, 1.4);
  }
  return c;
}

/* stacked splashback tile */
function tileCanvas(){
  const w = 512, h = 512, c = cvs(w,h), g = c.getContext('2d');
  g.fillStyle = P.grout; g.fillRect(0,0,w,h);
  const cols = 4, rows = 8, tw = w/cols, th = h/rows, gap = 3.2;
  for(let r=0;r<rows;r++){
    const off = (r%2) ? tw/2 : 0;
    for(let i=-1;i<=cols;i++){
      const x = i*tw + off, y = r*th;
      const base = shift(P.tile, (Math.random()-0.5)*0.045, (Math.random()-0.5)*0.03);
      g.fillStyle = base;
      g.fillRect(x+gap, y+gap, tw-gap*2, th-gap*2);
      /* glaze: light off the top edge, a pool at the bottom */
      const grd = g.createLinearGradient(x, y, x, y+th);
      grd.addColorStop(0, 'rgba(255,255,255,0.30)');
      grd.addColorStop(0.45,'rgba(255,255,255,0.02)');
      grd.addColorStop(1, 'rgba(70,62,48,0.10)');
      g.fillStyle = grd; g.fillRect(x+gap, y+gap, tw-gap*2, th-gap*2);
    }
  }
  speckle(g, w, h, 1400, 0.035);
  return c;
}

/* brushed stainless — the brush runs down the panel, so the strokes run down v */
function steelCanvas(base){
  base = base || P.steel;
  const w = 512, h = 512, c = cvs(w,h), g = c.getContext('2d');
  g.fillStyle = base; g.fillRect(0,0,w,h);
  for(let i=0;i<6000;i++){
    g.strokeStyle = shift(base, (Math.random()-0.5)*0.22);
    g.globalAlpha = 0.05 + Math.random()*0.14;
    g.lineWidth = 0.5 + Math.random()*1.5;
    const x = Math.random()*w, y = Math.random()*h, len = 14 + Math.random()*110;
    g.beginPath(); g.moveTo(x,y); g.lineTo(x + (Math.random()-0.5)*1.5, y+len); g.stroke();
  }
  g.globalAlpha = 1;
  const grd = g.createLinearGradient(0,0,w,0);         /* broad sheen across the door */
  grd.addColorStop(0,   'rgba(255,255,255,0.16)');
  grd.addColorStop(0.20,'rgba(30,36,44,0.14)');
  grd.addColorStop(0.46,'rgba(255,255,255,0.26)');
  grd.addColorStop(0.70,'rgba(30,36,44,0.10)');
  grd.addColorStop(1,   'rgba(255,255,255,0.12)');
  g.fillStyle = grd; g.fillRect(0,0,w,h);
  const vert = g.createLinearGradient(0,0,0,h);        /* the ceiling, seen in the door */
  vert.addColorStop(0,   'rgba(255,255,255,0.22)');
  vert.addColorStop(0.30,'rgba(255,255,255,0.03)');
  vert.addColorStop(0.82,'rgba(26,30,36,0.10)');
  vert.addColorStop(1,   'rgba(26,30,36,0.20)');
  g.fillStyle = vert; g.fillRect(0,0,w,h);
  return c;
}

/* the roughness map that makes the brushing catch the light unevenly */
function steelRoughCanvas(){
  const w = 256, h = 256, c = cvs(w,h), g = c.getContext('2d');
  g.fillStyle = '#4a4a4a'; g.fillRect(0,0,w,h);
  for(let i=0;i<2600;i++){
    const v = 40 + Math.random()*110;
    g.strokeStyle = 'rgb(' + v + ',' + v + ',' + v + ')';
    g.globalAlpha = 0.5;
    g.lineWidth = 0.6 + Math.random()*1.6;
    const x = Math.random()*w, y = Math.random()*h;
    g.beginPath(); g.moveTo(x,y); g.lineTo(x, y + 20 + Math.random()*70); g.stroke();
  }
  g.globalAlpha = 1;
  return c;
}

function radialCanvas(inner, mid){
  const s = 256, c = cvs(s,s), g = c.getContext('2d');
  const grd = g.createRadialGradient(s/2,s/2,0,s/2,s/2,s/2);
  grd.addColorStop(0, 'rgba(255,255,255,' + inner + ')');
  grd.addColorStop(mid || 0.42, 'rgba(255,255,255,' + (inner*0.42) + ')');
  grd.addColorStop(1, 'rgba(255,255,255,0)');
  g.fillStyle = grd; g.fillRect(0,0,s,s);
  return c;
}

/* what you see through the opening: light, and no detail at all */
function beyondCanvas(){
  const w = 256, h = 256, c = cvs(w,h), g = c.getContext('2d');
  const grd = g.createLinearGradient(0,0,0,h);
  grd.addColorStop(0,    '#f3ead6');
  grd.addColorStop(0.42, '#eadfc7');
  grd.addColorStop(0.70, '#d8cbaf');
  grd.addColorStop(1,    '#b5a68a');
  g.fillStyle = grd; g.fillRect(0,0,w,h);
  blotch(g, w, h, '#efe4cd', 22, 1.4, 0.4);
  return c;
}

function waterCanvas(){
  const w = 64, h = 256, c = cvs(w,h), g = c.getContext('2d');
  g.fillStyle = 'rgba(255,255,255,0.35)'; g.fillRect(0,0,w,h);
  for(let i=0;i<160;i++){
    g.strokeStyle = 'rgba(255,255,255,' + (0.1+Math.random()*0.55).toFixed(2) + ')';
    g.lineWidth = 0.6 + Math.random()*2.4;
    const x = Math.random()*w, y = Math.random()*h;
    g.beginPath(); g.moveTo(x,y); g.lineTo(x + (Math.random()-0.5)*2, y + 8 + Math.random()*40); g.stroke();
  }
  return c;
}

/* ============================================================
   4. MATERIALS
   ============================================================ */
const wallTex     = tex(plasterCanvas(1024, 512, {bottom:0.22, top:0.30}), 3, 1.4);
const wallPlainTex= tex(plasterCanvas(512, 512, {top:0.30}), 2, 2);
const trimTex     = tex(paintCanvas(256,256,P.trim), 3, 3);
const cabTex      = tex(paintCanvas(512,512,P.cabinet));
const cabRailTex  = tex(paintCanvas(256,256,P.cabRail), 2, 2);
const floorTex    = tex(floorCanvas(), 5, 5);
const stoneTex    = tex(stoneCanvas(), 3, 1);
const tileTex     = tex(tileCanvas(), 6, 1);
const steelTex    = tex(steelCanvas());
const steelRough  = tex(steelRoughCanvas());
const steelDarkTex= tex(steelCanvas(P.steelDark));
const waterTex    = tex(waterCanvas(), 1, 3);
waterTex.wrapS = waterTex.wrapT = THREE.RepeatWrapping;

const M = {
  wall:    new THREE.MeshStandardMaterial({map:wallTex, bumpMap:wallTex, bumpScale:0.003, roughness:0.93}),
  wallPlain:new THREE.MeshStandardMaterial({map:wallPlainTex, bumpMap:wallPlainTex, bumpScale:0.003, roughness:0.93}),
  ceiling: new THREE.MeshStandardMaterial({color:P.ceiling, roughness:1}),
  trim:    new THREE.MeshStandardMaterial({map:trimTex, bumpMap:trimTex, bumpScale:0.003, roughness:0.62}),
  floor:   new THREE.MeshStandardMaterial({map:floorTex, bumpMap:floorTex, bumpScale:0.006,
                                           roughness:0.55, metalness:0.02}),
  cabinet: new THREE.MeshStandardMaterial({map:cabTex, bumpMap:cabTex, bumpScale:0.0025, roughness:0.58}),
  cabRail: new THREE.MeshStandardMaterial({map:cabRailTex, bumpMap:cabRailTex, bumpScale:0.0025, roughness:0.56}),
  carcass: new THREE.MeshStandardMaterial({map:cabRailTex, bumpMap:cabRailTex, bumpScale:0.002, roughness:0.6}),
  toe:     new THREE.MeshStandardMaterial({color:P.toe, roughness:0.9}),
  counter: new THREE.MeshStandardMaterial({map:stoneTex, bumpMap:stoneTex, bumpScale:0.002,
                                           roughness:0.34, metalness:0.03}),
  tile:    new THREE.MeshStandardMaterial({map:tileTex, bumpMap:tileTex, bumpScale:0.004, roughness:0.22}),
  steel:   new THREE.MeshStandardMaterial({map:steelTex, roughnessMap:steelRough,
                                           roughness:0.24, metalness:0.97}),
  steelDark:new THREE.MeshStandardMaterial({map:steelDarkTex, roughnessMap:steelRough,
                                           roughness:0.34, metalness:0.92}),
  gasket:  new THREE.MeshStandardMaterial({color:'#3a3d40', roughness:0.85}),
  brass:   new THREE.MeshStandardMaterial({color:P.brass, roughness:0.28, metalness:0.9}),
  ringTrim:new THREE.MeshStandardMaterial({color:'#e9e4d8', roughness:0.5, metalness:0.1}),
  lens:    new THREE.MeshStandardMaterial({color:'#fff4de', roughness:0.4,
                                           emissive:P.glow, emissiveIntensity:1.6}),
  switch:  new THREE.MeshStandardMaterial({color:'#f4efe3', roughness:0.4})
};

/* ============================================================
   5. HELPERS
   ============================================================ */
function box(w,h,d,mat,x,y,z){
  const m = new THREE.Mesh(new THREE.BoxGeometry(w,h,d), mat);
  m.position.set(x||0,y||0,z||0);
  m.castShadow = true; m.receiveShadow = true;
  return m;
}
function plate(w,h,mat,x,y,z){          /* flat, never casts */
  const m = new THREE.Mesh(new THREE.PlaneGeometry(w,h), mat);
  m.position.set(x||0,y||0,z||0);
  m.receiveShadow = true;
  return m;
}

/* ============================================================
   6. JOINERY
   ------------------------------------------------------------
   Every unit is built in its own local frame: origin sits on the
   floor, against the wall plane, and +Z runs out into the room.
   A run is then dropped on a wall and rotated once.
   ============================================================ */
const CAB = {
  baseH:0.90, baseD:0.60, counterT:0.045, counterD:0.66,
  toe:0.11,  toeIn:0.075,
  upY:1.52,  upH:0.92,  upD:0.34,
  tallH:2.44, tallD:0.66,
  reveal:0.014, frontT:0.036, rail:0.078
};
const COUNTER_Y = CAB.baseH + CAB.counterT;      /* 0.945 — the working height */

/* a shaker front: recessed centre panel inside a frame stood proud of it */
function shakerFront(w, h, opts){
  opts = opts || {};
  const g = new THREE.Group();
  const t = CAB.frontT, r = Math.min(CAB.rail, w/2 - 0.02, h/2 - 0.02);
  g.add(box(w, h, t, M.cabinet, 0, 0, 0));                       /* panel */
  const ft = t + 0.024, fz = 0.012;                              /* frame, 24mm proud */
  g.add(box(w, r, ft, M.cabRail, 0,  h/2 - r/2, fz));
  g.add(box(w, r, ft, M.cabRail, 0, -h/2 + r/2, fz));
  g.add(box(r, h - r*2, ft, M.cabRail, -w/2 + r/2, 0, fz));
  g.add(box(r, h - r*2, ft, M.cabRail,  w/2 - r/2, 0, fz));
  if(opts.knob) g.add(knob(0, 0, 0.044));
  return g;
}

function barPull(len){
  const g = new THREE.Group();
  const bar = new THREE.Mesh(new THREE.CylinderGeometry(0.011, 0.011, len, 10), M.brass);
  bar.rotation.z = Math.PI/2; bar.position.z = 0.088;
  bar.castShadow = true;
  g.add(bar);
  const postGeo = new THREE.CylinderGeometry(0.0085, 0.0085, 0.052, 8);
  [-1, 1].forEach(function(s){
    const p = new THREE.Mesh(postGeo, M.brass);
    p.rotation.x = Math.PI/2;
    p.position.set(s*(len/2 - 0.028), 0, 0.062);
    p.castShadow = true;
    g.add(p);
  });
  return g;
}
function knob(x, y, z){
  const g = new THREE.Group();
  const stem = new THREE.Mesh(new THREE.CylinderGeometry(0.008, 0.008, 0.03, 8), M.brass);
  stem.rotation.x = Math.PI/2; stem.position.z = 0.015;
  const head = new THREE.Mesh(new THREE.SphereGeometry(0.019, 14, 10), M.brass);
  head.position.z = 0.038;
  head.scale.set(1, 1, 0.8);
  g.add(stem, head);
  g.position.set(x||0, y||0, z||0);
  return g;
}

/* carcass + recessed kick, shared by every floor-standing unit */
function carcass(w, h, d, withToe){
  const g = new THREE.Group();
  if(withToe){
    g.add(box(w, CAB.toe, d - CAB.toeIn, M.toe, 0, CAB.toe/2, (d - CAB.toeIn)/2));
    g.add(box(w, h - CAB.toe, d, M.carcass, 0, CAB.toe + (h - CAB.toe)/2, d/2));
  } else {
    g.add(box(w, h, d, M.carcass, 0, h/2, d/2));
  }
  return g;
}

/* n equal drawer fronts filling the space between the kick and the worktop */
function baseDrawers(w, n){
  const g = new THREE.Group();
  g.add(carcass(w, CAB.baseH, CAB.baseD, true));
  const y0 = CAB.toe, span = CAB.baseH - CAB.toe;
  const fw = w - CAB.reveal*2;
  const fh = (span - CAB.reveal*(n + 1)) / n;
  for(let i=0;i<n;i++){
    const y = y0 + CAB.reveal*(i+1) + fh*i + fh/2;
    const f = shakerFront(fw, fh, {pull:false});
    f.position.set(0, y, CAB.baseD + 0.018);
    f.add(barPull(Math.min(0.30, fw*0.42)));
    g.add(f);
  }
  return g;
}

/* the classic: one shallow drawer over a pair of doors */
function baseDoors(w, n){
  const g = new THREE.Group();
  g.add(carcass(w, CAB.baseH, CAB.baseD, true));
  const y0 = CAB.toe, span = CAB.baseH - CAB.toe;
  const dh = 0.185, fw = w - CAB.reveal*2;
  const dy = y0 + span - CAB.reveal - dh/2;
  const drw = shakerFront(fw, dh, {pull:false});
  drw.position.set(0, dy, CAB.baseD + 0.018);
  drw.add(barPull(Math.min(0.30, fw*0.42)));
  g.add(drw);

  const doorH = span - dh - CAB.reveal*3;
  const doorW = (fw - CAB.reveal*(n-1)) / n;
  const dcy = y0 + CAB.reveal + doorH/2;
  for(let i=0;i<n;i++){
    const x = -fw/2 + doorW/2 + i*(doorW + CAB.reveal);
    const d = shakerFront(doorW, doorH, {pull:false});
    d.position.set(x, dcy, CAB.baseD + 0.018);
    const p = barPull(Math.min(0.20, doorH*0.34));
    p.rotation.z = Math.PI/2;                      /* pulls stand upright on a door */
    p.position.set(n === 1 ? doorW/2 - 0.055 : (i === 0 ? doorW/2 - 0.055 : -doorW/2 + 0.055),
                   doorH/2 - 0.20, 0);
    d.add(p);
    g.add(d);
  }
  return g;
}

/* full-height pantry: deep drawer at the floor, then two banks of doors */
function tallPantry(w){
  const g = new THREE.Group();
  g.add(carcass(w, CAB.tallH, CAB.tallD, true));
  const fw = w - CAB.reveal*2;
  const drawH = 0.30, midH = 0.95;
  let y = CAB.toe + CAB.reveal;

  const dr = shakerFront(fw, drawH, {pull:false});
  dr.position.set(0, y + drawH/2, CAB.tallD + 0.018);
  dr.add(barPull(Math.min(0.34, fw*0.44)));
  g.add(dr);
  y += drawH + CAB.reveal;

  function pair(h){
    const dw = (fw - CAB.reveal)/2;
    for(let i=0;i<2;i++){
      const d = shakerFront(dw, h, {pull:false});
      d.position.set(-fw/2 + dw/2 + i*(dw + CAB.reveal), y + h/2, CAB.tallD + 0.018);
      const p = barPull(Math.min(0.30, h*0.30));
      p.rotation.z = Math.PI/2;
      p.position.set(i === 0 ? dw/2 - 0.055 : -dw/2 + 0.055, h/2 - 0.26, 0);
      d.add(p);
      g.add(d);
    }
    y += h + CAB.reveal;
  }
  pair(midH);
  pair(CAB.tallH - y);
  return g;
}

/* wall unit — n doors, hung at CAB.upY unless told otherwise */
function upperUnit(w, h, n, yBase, depth){
  const g = new THREE.Group();
  h = h || CAB.upH; yBase = (yBase === undefined) ? CAB.upY : yBase;
  depth = depth || CAB.upD;
  const c = box(w, h, depth, M.carcass, 0, yBase + h/2, depth/2);
  g.add(c);
  const fw = w - CAB.reveal*2, doorH = h - CAB.reveal*2;
  const doorW = (fw - CAB.reveal*(n-1)) / n;
  for(let i=0;i<n;i++){
    const d = shakerFront(doorW, doorH, {pull:false});
    d.position.set(-fw/2 + doorW/2 + i*(doorW + CAB.reveal), yBase + h/2, depth + 0.018);
    const p = barPull(Math.min(0.24, doorH*0.30));
    p.rotation.z = Math.PI/2;
    p.position.set(n === 1 ? doorW/2 - 0.055 : (i === 0 ? doorW/2 - 0.055 : -doorW/2 + 0.055),
                   -doorH/2 + 0.20, 0);
    d.add(p);
    g.add(d);
  }
  return g;
}

/* worktop slab with a shadow line under its front lip */
function worktop(w, d, x, z){
  const g = new THREE.Group();
  d = d || CAB.counterD;
  g.add(box(w, CAB.counterT, d, M.counter, 0, CAB.baseH + CAB.counterT/2, d/2));
  g.add(box(w, 0.016, 0.020, M.counter, 0, CAB.baseH - 0.008, d - 0.010));
  g.position.set(x||0, 0, z||0);
  return g;
}

/* splashback: tile from the worktop to the underside of the wall units */
function splash(w, y0, y1, mat, repeatX){
  const t = tileTex.clone();
  t.needsUpdate = true;
  t.wrapS = t.wrapT = THREE.RepeatWrapping;
  t.repeat.set(repeatX || w*1.9, (y1 - y0)*1.9);
  const m = new THREE.MeshStandardMaterial({map:t, bumpMap:t, bumpScale:0.004, roughness:0.22});
  const p = new THREE.Mesh(new THREE.PlaneGeometry(w, y1 - y0), m);
  p.position.set(0, (y0 + y1)/2, 0.006);
  p.receiveShadow = true;
  return p;
}

/* ============================================================
   7. THE FRIDGE — two doors, brushed, standing proud of the run
   ============================================================ */
const FR = {w:1.12, h:2.05, d:0.76};
function buildFridge(){
  const g = new THREE.Group();
  g.userData.name = 'Fridge';
  g.userData.hoverable = true;

  /* the box itself, darker so the doors read as the bright thing */
  g.add(box(FR.w, FR.h, FR.d, M.steelDark, 0, FR.h/2, FR.d/2));
  /* the rubber seal you glimpse round the edge of each door */
  g.add(box(FR.w - 0.02, FR.h - 0.02, 0.03, M.gasket, 0, FR.h/2, FR.d + 0.005));

  const gap = 0.016;
  const dw = (FR.w - gap)/2 - 0.006;
  const dh = FR.h - 0.10;
  const dz = FR.d + 0.02;                       /* front face of the doors */

  [-1, 1].forEach(function(s){
    const x = s * (dw/2 + gap/2);
    const door = new THREE.Group();
    door.add(box(dw, dh, 0.075, M.steel, 0, 0, -0.0375));
    /* a soft chamfer down each outer edge catches the ceiling light */
    door.add(box(0.016, dh, 0.06, M.steelDark, s*(dw/2 - 0.008), 0, -0.030));
    door.position.set(x, 0.05 + dh/2, dz);
    g.add(door);

    /* full-height bar handle, set just off the centre seam */
    const hx = x - s*(dw/2 - 0.075);
    const bar = new THREE.Mesh(new THREE.CylinderGeometry(0.016, 0.016, dh*0.62, 12), M.steel);
    bar.castShadow = true;
    bar.position.set(hx, 0.05 + dh/2, dz + 0.062);
    g.add(bar);
    const bracket = new THREE.CylinderGeometry(0.014, 0.014, 0.062, 8);
    [-1, 1].forEach(function(k){
      const b = new THREE.Mesh(bracket, M.steel);
      b.rotation.x = Math.PI/2;
      b.position.set(hx, 0.05 + dh/2 + k*(dh*0.62/2 - 0.03), dz + 0.031);
      b.castShadow = true;
      g.add(b);
    });
  });

  /* centre seam, and the vented plinth under the doors */
  g.add(box(gap + 0.004, dh, 0.02, M.gasket, 0, 0.05 + dh/2, dz - 0.05));
  g.add(box(FR.w, 0.05, 0.03, M.steelDark, 0, 0.025, dz - 0.01));
  /* top return, so the eye reads a lid rather than a cut-off */
  g.add(box(FR.w + 0.006, 0.018, FR.d + 0.02, M.steelDark, 0, FR.h - 0.009, (FR.d + 0.02)/2));
  return g;
}

/* ============================================================
   8. SINK AND TAP
   ============================================================ */
const SINK = {w:0.84, len:0.50, deep:0.24, t:0.014};
function buildSink(){
  /* built in the left run's local frame: +X along the wall, +Z out from it.
     the rim sits flush with the worktop; everything below is one pressed bowl. */
  const g = new THREE.Group();
  g.userData.name = 'Sink';
  g.userData.hoverable = true;
  const y = COUNTER_Y, W = SINK.w, L = SINK.len, D = SINK.deep, t = SINK.t;

  /* rim, sitting on top of the stone all the way round the cut-out */
  const rim = 0.026;
  [[0, -L/2 - rim/2, W + rim*2, rim], [0, L/2 + rim/2, W + rim*2, rim]].forEach(function(a){
    g.add(box(a[2], 0.008, a[3], M.steel, a[0], y + 0.004, a[1]));
  });
  [[-W/2 - rim/2, 0], [W/2 + rim/2, 0]].forEach(function(a){
    g.add(box(rim, 0.008, L, M.steel, a[0], y + 0.004, a[1]));
  });

  /* bowl */
  g.add(box(W, t, L, M.steel, 0, y - D + t/2, 0));                       /* base */
  g.add(box(W, D, t, M.steel, 0, y - D/2, -L/2 + t/2));                  /* back */
  g.add(box(W, D, t, M.steel, 0, y - D/2,  L/2 - t/2));                  /* front */
  g.add(box(t, D, L, M.steel, -W/2 + t/2, y - D/2, 0));
  g.add(box(t, D, L, M.steel,  W/2 - t/2, y - D/2, 0));

  /* waste */
  const waste = new THREE.Mesh(new THREE.CylinderGeometry(0.042, 0.042, 0.012, 18), M.steelDark);
  waste.position.set(0, y - D + 0.014, 0);
  g.add(waste);
  const grate = new THREE.Mesh(new THREE.CylinderGeometry(0.030, 0.030, 0.006, 18), M.gasket);
  grate.position.set(0, y - D + 0.021, 0);
  g.add(grate);
  return g;
}

function buildTap(){
  /* a gooseneck drawn as a tube along a curve, so the bend stays round */
  const g = new THREE.Group();
  g.userData.name = 'Tap';
  g.userData.hoverable = true;
  g.userData.isTap = true;

  const pts = [
    new THREE.Vector3(0, 0.00, 0),
    new THREE.Vector3(0, 0.20, 0),
    new THREE.Vector3(0, 0.33, 0.015),
    new THREE.Vector3(0, 0.405, 0.085),
    new THREE.Vector3(0, 0.375, 0.185),
    new THREE.Vector3(0, 0.275, 0.238),
    new THREE.Vector3(0, 0.205, 0.243)
  ];
  const curve = new THREE.CatmullRomCurve3(pts);
  const tube = new THREE.Mesh(new THREE.TubeGeometry(curve, 48, 0.019, 12, false), M.steel);
  tube.castShadow = true;
  g.add(tube);

  /* escutcheon on the stone, spout collar, and a single lever */
  const base = new THREE.Mesh(new THREE.CylinderGeometry(0.036, 0.040, 0.022, 20), M.steel);
  base.position.y = 0.011; base.castShadow = true;
  g.add(base);
  const collar = new THREE.Mesh(new THREE.CylinderGeometry(0.024, 0.024, 0.022, 16), M.steel);
  collar.position.set(0, 0.212, 0.243);
  g.add(collar);

  const lever = new THREE.Group();
  const hub = new THREE.Mesh(new THREE.CylinderGeometry(0.021, 0.021, 0.036, 14), M.steel);
  hub.rotation.z = Math.PI/2; hub.position.set(0.026, 0, 0);
  const arm = new THREE.Mesh(new THREE.CylinderGeometry(0.011, 0.013, 0.115, 12), M.steel);
  arm.rotation.z = Math.PI/2; arm.position.set(0.098, 0.014, 0);
  arm.rotation.y = 0;
  lever.add(hub, arm);
  lever.position.set(0.014, 0.235, 0.005);
  lever.rotation.x = -0.30;
  g.add(lever);
  g.userData.lever = lever;

  /* the stream — hidden until the tap is turned on */
  const streamH = 0.44;
  const stream = new THREE.Mesh(
    new THREE.CylinderGeometry(0.0075, 0.0115, streamH, 12, 1, true),
    new THREE.MeshStandardMaterial({map:waterTex, color:0xdff0ff, transparent:true, opacity:0,
      roughness:0.06, metalness:0.0, side:THREE.DoubleSide, depthWrite:false}));
  stream.position.set(0, 0.205 - streamH/2, 0.243);
  g.add(stream);
  g.userData.stream = stream;

  /* and the disturbance it makes at the bottom of the bowl */
  const splashTex = new THREE.CanvasTexture(radialCanvas(1, 0.30));
  const splashRing = new THREE.Mesh(new THREE.PlaneGeometry(0.20, 0.20),
    new THREE.MeshBasicMaterial({map:splashTex, color:0xffffff, transparent:true,
      opacity:0, depthWrite:false}));
  splashRing.rotation.x = -Math.PI/2;
  splashRing.position.set(0, 0.205 - streamH + 0.006, 0.243);
  g.add(splashRing);
  g.userData.splash = splashRing;
  return g;
}

/* ============================================================
   9. THE SHELL — floor, ceiling, three walls and one wide gap
   ============================================================ */
const OUT_X = SIDE_X + 3.4;                 /* the floor keeps going past the opening */
const FLOOR_W = OUT_X + SIDE_X, FLOOR_D = FRONT_Z - BACK_Z;
const FLOOR_CX = (OUT_X - SIDE_X)/2, FLOOR_CZ = (BACK_Z + FRONT_Z)/2;

const floor = plate(FLOOR_W, FLOOR_D, M.floor, FLOOR_CX, 0, FLOOR_CZ);
floor.rotation.x = -Math.PI/2;
floor.material.map.repeat.set(FLOOR_W/2.1, FLOOR_D/2.1);
scene.add(floor);

const ceil = plate(FLOOR_W, FLOOR_D, M.ceiling, FLOOR_CX, WALL_H, FLOOR_CZ);
ceil.rotation.x = Math.PI/2;
scene.add(ceil);

/* back wall */
scene.add(box(SIDE_X*2, WALL_H, WALL_T, M.wall, 0, WALL_H/2, BACK_Z - WALL_T/2));
/* left wall */
const leftWall = box(FLOOR_D, WALL_H, WALL_T, M.wall, 0, 0, 0);
leftWall.rotation.y = Math.PI/2;
leftWall.position.set(-SIDE_X - WALL_T/2, WALL_H/2, FLOOR_CZ);
scene.add(leftWall);
/* front wall, behind the camera — only ever seen as bounce */
const frontWall = box(SIDE_X*2, WALL_H, WALL_T, M.wallPlain, 0, WALL_H/2, FRONT_Z + WALL_T/2);
scene.add(frontWall);

/* right wall: two returns and a header, leaving a 4.6 m gap onto the rest of it */
function rightPanel(z0, z1, y0, y1){
  const p = box(z1 - z0, y1 - y0, WALL_T, M.wall, 0, 0, 0);
  p.rotation.y = Math.PI/2;
  p.position.set(SIDE_X + WALL_T/2, (y0 + y1)/2, (z0 + z1)/2);
  scene.add(p);
  return p;
}
rightPanel(BACK_Z, OPEN_Z0, 0, WALL_H);
rightPanel(OPEN_Z1, FRONT_Z, 0, WALL_H);
rightPanel(OPEN_Z0, OPEN_Z1, OPEN_H, WALL_H);

/* the casing round the opening — the one piece of joinery that says "through here" */
(function(){
  const t = 0.09, d = WALL_T + 0.05;
  [OPEN_Z0, OPEN_Z1].forEach(function(z){
    const j = box(t, OPEN_H + t, d, M.trim, 0, 0, 0);
    j.rotation.y = Math.PI/2;
    j.position.set(SIDE_X + WALL_T/2, (OPEN_H + t)/2, z + (z === OPEN_Z0 ? -t/2 : t/2));
    scene.add(j);
  });
  const head = box(OPEN_Z1 - OPEN_Z0 + t*2, t, d, M.trim, 0, 0, 0);
  head.rotation.y = Math.PI/2;
  head.position.set(SIDE_X + WALL_T/2, OPEN_H + t/2, (OPEN_Z0 + OPEN_Z1)/2);
  scene.add(head);
  /* reveal: the thickness of the wall you see edge-on standing in the gap */
  [[OPEN_Z0, -1], [OPEN_Z1, 1]].forEach(function(a){
    const r = box(WALL_T, OPEN_H, 0.02, M.trim, 0, 0, 0);
    r.position.set(SIDE_X + WALL_T/2, OPEN_H/2, a[0] + a[1]*0.01);
    scene.add(r);
  });
})();

/* beyond the opening: light and nothing else */
(function(){
  const t = new THREE.CanvasTexture(beyondCanvas());
  t.encoding = THREE.sRGBEncoding;
  const m = new THREE.Mesh(new THREE.PlaneGeometry(20, 12),
    new THREE.MeshBasicMaterial({map:t, fog:false}));
  m.rotation.y = -Math.PI/2;
  m.position.set(OUT_X - 0.3, 3.2, (OPEN_Z0 + OPEN_Z1)/2);
  scene.add(m);
  /* the floor out there falls away into the same light */
  const f = new THREE.Mesh(new THREE.PlaneGeometry(3.6, 12),
    new THREE.MeshBasicMaterial({map:t, transparent:true, opacity:0.5, fog:false,
                                 depthWrite:false}));
  f.rotation.x = -Math.PI/2;
  f.position.set(SIDE_X + 1.8, 0.004, (OPEN_Z0 + OPEN_Z1)/2);
  f.renderOrder = 2;
  scene.add(f);
})();

/* skirting and cornice */
(function(){
  const sk = 0.10, sd = 0.020, co = 0.075, cd = 0.055;
  function run(len, rotY, x, z, y, h, d){
    const b = box(len, h, d, M.trim, 0, 0, 0);
    b.rotation.y = rotY; b.position.set(x, y, z);
    scene.add(b);
  }
  run(SIDE_X*2, 0, 0, BACK_Z + sd/2, sk/2, sk, sd);
  run(FLOOR_D, Math.PI/2, -SIDE_X + sd/2, FLOOR_CZ, sk/2, sk, sd);
  run(OPEN_Z0 - BACK_Z, Math.PI/2, SIDE_X - sd/2, (BACK_Z + OPEN_Z0)/2, sk/2, sk, sd);
  run(FRONT_Z - OPEN_Z1, Math.PI/2, SIDE_X - sd/2, (OPEN_Z1 + FRONT_Z)/2, sk/2, sk, sd);
  run(SIDE_X*2, 0, 0, FRONT_Z - sd/2, sk/2, sk, sd);

  run(SIDE_X*2, 0, 0, BACK_Z + cd/2, WALL_H - co/2, co, cd);
  run(FLOOR_D, Math.PI/2, -SIDE_X + cd/2, FLOOR_CZ, WALL_H - co/2, co, cd);
  run(FLOOR_D, Math.PI/2, SIDE_X - cd/2, FLOOR_CZ, WALL_H - co/2, co, cd);
  run(SIDE_X*2, 0, 0, FRONT_Z - cd/2, WALL_H - co/2, co, cd);
})();

/* ============================================================
   10. THE BACK RUN — fridge dead centre, pantry either side
   ============================================================ */
const hoverables = [];
const backRun = new THREE.Group();
backRun.position.set(0, 0, BACK_Z);
scene.add(backRun);

const fridge = buildFridge();
fridge.position.set(0, 0, 0.006);
backRun.add(fridge);
hoverables.push(fridge);

/* bridging cupboard over the fridge, so the run reads as one wall of joinery */
const overFridge = upperUnit(1.20, 0.34, 2, 2.10, CAB.tallD);
backRun.add(overFridge);

[-1.22, 1.22].forEach(function(x){
  const t = tallPantry(1.20);
  t.position.x = x;
  t.userData.name = 'Pantry';
  t.userData.hoverable = true;
  backRun.add(t);
  hoverables.push(t);
});

[-1, 1].forEach(function(s){
  const doors = baseDoors(1.46, 2);   doors.position.x = s*3.17;
  const draws = baseDrawers(0.60, 3); draws.position.x = s*2.14;
  backRun.add(doors, draws);
  backRun.add(worktop(2.06, CAB.counterD, s*2.87, 0));

  const sp = splash(2.06, COUNTER_Y, CAB.upY, null, 4);
  sp.position.x = s*2.87;
  backRun.add(sp);

  const up = upperUnit(2.06, CAB.upH, 2);
  up.position.x = s*2.87;
  backRun.add(up);
});

/* ============================================================
   11. THE LEFT RUN — sink and tap
   ============================================================ */
const LRUN = {len:5.44, z0:-4.84, z1:0.60};   /* z0 mitres onto the back worktop */
const leftRun = new THREE.Group();
leftRun.position.set(-SIDE_X, 0, (LRUN.z0 + LRUN.z1)/2);
leftRun.rotation.y = Math.PI/2;             /* local +X runs back, local +Z into the room */
scene.add(leftRun);

const SINK_X = 0.46, HOLE0 = 0.04, HOLE1 = 0.88, HOLE_Z0 = 0.08, HOLE_Z1 = 0.58;
const HX0 = -LRUN.len/2, HX1 = LRUN.len/2;

[[1.38, 'doors', -2.03, 2], [0.62, 'drawers', -1.03, 3], [0.70, 'drawers', -0.37, 2],
 [0.96, 'doors', SINK_X, 2], [0.90, 'doors', 1.39, 2], [0.88, 'drawers', 2.28, 3]
].forEach(function(u){
  const unit = (u[1] === 'doors') ? baseDoors(u[0], u[3]) : baseDrawers(u[0], u[3]);
  unit.position.x = u[2];
  leftRun.add(unit);
});

/* the worktop, cut round the bowl */
function slab(w, d, x, z){
  const b = box(w, CAB.counterT, d, M.counter, x, CAB.baseH + CAB.counterT/2, z);
  leftRun.add(b);
}
slab(HOLE0 - HX0, CAB.counterD, (HX0 + HOLE0)/2, CAB.counterD/2);
slab(HX1 - HOLE1, CAB.counterD, (HOLE1 + HX1)/2, CAB.counterD/2);
slab(HOLE1 - HOLE0, HOLE_Z0, SINK_X, HOLE_Z0/2);
slab(HOLE1 - HOLE0, CAB.counterD - HOLE_Z1, SINK_X, (HOLE_Z1 + CAB.counterD)/2);
leftRun.add(box(LRUN.len, 0.016, 0.020, M.counter, 0, CAB.baseH - 0.008, CAB.counterD - 0.010));

const sink = buildSink();
sink.position.set(SINK_X, 0, (HOLE_Z0 + HOLE_Z1)/2);
leftRun.add(sink);
hoverables.push(sink);

const tap = buildTap();
tap.position.set(SINK_X, COUNTER_Y, 0.048);
leftRun.add(tap);
hoverables.push(tap);

/* tile: a band the length of the run, and a full-height panel behind the bowl */
const lsp = splash(LRUN.len, COUNTER_Y, CAB.upY, null, 11);
leftRun.add(lsp);
const tallTile = splash(HOLE1 - HOLE0 + 0.08, CAB.upY, CAB.tallH, null, 2);
tallTile.position.x = SINK_X;
leftRun.add(tallTile);

/* wall units either side of the window of tile above the sink */
const upA = upperUnit(2.70, CAB.upH, 3);  upA.position.x = -1.37;
const upB = upperUnit(1.78, CAB.upH, 2);  upB.position.x =  1.83;
leftRun.add(upA, upB);

/* ============================================================
   12. THE SWITCH — on the return by the opening
   ============================================================ */
const switchPlate = (function(){
  const g = new THREE.Group();
  g.userData.name = 'Lights';
  g.userData.hoverable = true;
  g.userData.isSwitch = true;
  g.add(box(0.088, 0.130, 0.012, M.switch, 0, 0, 0.006));
  const rockers = [];
  [-1, 1].forEach(function(s){
    const r = box(0.030, 0.052, 0.010, M.switch, s*0.019, 0, 0.014);
    rockers.push(r);
    g.add(r);
  });
  g.userData.rockers = rockers;
  g.rotation.y = -Math.PI/2;
  g.position.set(SIDE_X - 0.006, 1.26, -4.30);
  scene.add(g);
  return g;
})();
hoverables.push(switchPlate);

/* ============================================================
   13. LIGHT — it all comes down from the ceiling
   ------------------------------------------------------------
   Nine recessed fittings are modelled; three of them carry an
   actual spot. The rest are geometry plus a glare disc, which is
   what sells a ceiling of downlights without nine shadow maps.
   ============================================================ */
const glareTex = new THREE.CanvasTexture(radialCanvas(1, 0.28));
const lenses = [], halos = [], pools = [];

function downlight(x, z){
  const g = new THREE.Group();
  const ring = new THREE.Mesh(new THREE.CylinderGeometry(0.086, 0.078, 0.026, 20), M.ringTrim);
  ring.position.y = WALL_H - 0.013;
  const lens = new THREE.Mesh(new THREE.CylinderGeometry(0.064, 0.064, 0.010, 20), M.lens);
  lens.position.y = WALL_H - 0.030;
  g.add(ring, lens);
  lenses.push(lens);

  const halo = new THREE.Mesh(new THREE.PlaneGeometry(0.62, 0.62),
    new THREE.MeshBasicMaterial({map:glareTex, color:0xffe3b4, transparent:true,
      opacity:0.32, blending:THREE.AdditiveBlending, depthWrite:false, fog:false}));
  halo.rotation.x = Math.PI/2;
  halo.position.y = WALL_H - 0.042;
  halo.renderOrder = 3;
  g.add(halo);
  halos.push(halo);

  g.position.set(x, 0, z);
  scene.add(g);
}

const LIGHT_X = [-2.4, 0, 2.4], LIGHT_Z = [-3.5, -0.9, 1.7];
LIGHT_Z.forEach(function(z){ LIGHT_X.forEach(function(x){ downlight(x, z); }); });

/* the wash each fitting leaves on the floor */
function pool(size, opacity, x, z){
  const m = new THREE.Mesh(new THREE.PlaneGeometry(size, size),
    new THREE.MeshBasicMaterial({map:glareTex, color:0xffdba6, transparent:true,
      opacity:opacity, blending:THREE.AdditiveBlending, depthWrite:false, fog:false}));
  m.rotation.x = -Math.PI/2;
  m.position.set(x, 0.014, z);
  m.renderOrder = 3;
  m.userData.baseOpacity = opacity;
  pools.push(m);
  scene.add(m);
}
LIGHT_Z.forEach(function(z){ LIGHT_X.forEach(function(x){ pool(2.15, 0.038, x, z); }); });

const hemi = new THREE.HemisphereLight(0xfff4e2, 0x9d937b, 0.42);
scene.add(hemi);

const spots = [];
function spot(x, z, tx, ty, tz, intensity, shadow){
  const s = new THREE.SpotLight(0xfff0d6, intensity, 11, 0.82, 0.55, 1.1);
  s.position.set(x, WALL_H - 0.04, z);
  s.target.position.set(tx, ty, tz);
  if(shadow){
    s.castShadow = true;
    s.shadow.mapSize.set(1024, 1024);
    s.shadow.camera.near = 0.4;
    s.shadow.camera.far = 12;
    s.shadow.bias = -0.0012;
    s.shadow.radius = 3;
  }
  scene.add(s); scene.add(s.target);
  s.userData.base = intensity;
  spots.push(s);
  return s;
}
spot( 0.0, -3.5,  0.00, 1.10, -5.10, 1.30, true);   /* down the fridge wall */
spot(-2.4, -3.5, -3.50, 0.95, -3.20, 1.00, true);   /* over the sink */
spot(-2.4, -0.9, -3.50, 0.95, -1.40, 0.85, false);
spot( 2.4, -0.9,  2.40, 0.00, -0.90, 0.85, false);
spot( 0.0,  1.7,  0.20, 0.00,  2.20, 0.65, false);

/* a little light leaning in from the opening, so the gap reads as a source */
const throughGap = new THREE.DirectionalLight(0xfff1dc, 0.30);
throughGap.position.set(9, 2.6, -1.5);
throughGap.target.position.set(-1, 1.1, -3.0);
scene.add(throughGap); scene.add(throughGap.target);

/* a stand-in interior, pre-filtered — this is what the stainless reflects */
try{
  const pmrem = new THREE.PMREMGenerator(renderer);
  const env = new THREE.Scene();
  env.add(new THREE.Mesh(new THREE.BoxGeometry(10,10,10),
    new THREE.MeshBasicMaterial({color:0xbdb49f, side:THREE.BackSide})));
  const lid = new THREE.Mesh(new THREE.PlaneGeometry(10,10),
    new THREE.MeshBasicMaterial({color:0xfff6e6}));
  lid.rotation.x = Math.PI/2; lid.position.y = 4.9; env.add(lid);
  const gap = new THREE.Mesh(new THREE.PlaneGeometry(5.5,4.6),
    new THREE.MeshBasicMaterial({color:0xfff3e2}));
  gap.rotation.y = -Math.PI/2; gap.position.set(4.9, 0.4, 0); env.add(gap);
  const gnd = new THREE.Mesh(new THREE.PlaneGeometry(10,10),
    new THREE.MeshBasicMaterial({color:0x7d6549}));
  gnd.rotation.x = -Math.PI/2; gnd.position.y = -4.9; env.add(gnd);
  scene.environment = pmrem.fromScene(env, 0.04).texture;
  pmrem.dispose();
  scene.traverse(function(o){
    if(o.isMesh && o.material && o.material.isMeshStandardMaterial){
      o.material.envMapIntensity = o.material.metalness > 0.5 ? 1.75 : 0.35;
    }
  });
}catch(e){ /* environment is a bonus, not a requirement */ }

/* ============================================================
   14. INTERACTION
   ============================================================ */
const dom = renderer.domElement;
const pointer = new THREE.Vector2(0,0);
const look = {x:0, y:0}, target = {x:0, y:0};
let yaw = 0, yawT = 0, pitch = 0, pitchT = 0;
let dolly = 0, dollyT = 0;
let dragging = false, dragged = false, lastX = 0, lastY = 0;

const raycaster = new THREE.Raycaster();
let hovered = null;

let waterOn = false, waterLevel = 0;
let lightsOn = true, lightLevel = 1;

function toggleWater(){
  waterOn = !waterOn;
  waterSound(waterOn);
}
function toggleLights(){
  lightsOn = !lightsOn;
}
document.getElementById('lights').addEventListener('click', function(){
  toggleLights(); hideHint();
});

dom.style.cursor = 'grab';
dom.addEventListener('pointerdown', function(e){
  dragging = true; dragged = false;
  lastX = e.clientX; lastY = e.clientY;
  if(dom.setPointerCapture) dom.setPointerCapture(e.pointerId);
  dom.style.cursor = 'grabbing';
});
dom.addEventListener('pointermove', function(e){
  pointer.x =  (e.clientX/innerWidth)*2 - 1;
  pointer.y = -(e.clientY/innerHeight)*2 + 1;
  target.x = pointer.x; target.y = pointer.y;
  if(dragging){
    const dx = e.clientX - lastX, dy = e.clientY - lastY;
    if(Math.abs(dx) + Math.abs(dy) > 4) dragged = true;
    yawT   = THREE.MathUtils.clamp(yawT   - dx*0.0030, -1.18, 0.62);
    pitchT = THREE.MathUtils.clamp(pitchT - dy*0.0022, -0.34, 0.30);
    lastX = e.clientX; lastY = e.clientY;
    hideHint();
  }
});
function endDrag(){
  if(!dragging) return;
  dragging = false;
  dom.style.cursor = hovered && hovered.userData.clickable ? 'pointer' : 'grab';
  if(dragged || !hovered) return;
  if(hovered.userData.isTap) toggleWater();
  else if(hovered.userData.isSwitch) toggleLights();
}
dom.addEventListener('pointerup', endDrag);
dom.addEventListener('pointercancel', endDrag);
dom.addEventListener('pointerleave', function(){ tag.classList.remove('show'); });
dom.addEventListener('wheel', function(e){
  dollyT = THREE.MathUtils.clamp(dollyT - e.deltaY*0.0026, -0.4, 5.4);
  hideHint();
}, {passive:true});

tap.userData.clickable = true;
switchPlate.userData.clickable = true;

function updateHover(){
  raycaster.setFromCamera(pointer, camera);
  const hit = raycaster.intersectObjects(hoverables, true)[0];
  let group = null;
  if(hit){
    let o = hit.object;
    while(o && !o.userData.hoverable) o = o.parent;
    group = o;
  }
  if(group !== hovered){
    hovered = group;
    dom.style.cursor = dragging ? 'grabbing'
                     : (hovered && hovered.userData.clickable ? 'pointer' : 'grab');
  }
  if(hovered && hit){
    const p = hit.point.clone().project(camera);
    tag.style.left = (( p.x*0.5 + 0.5)*innerWidth) + 'px';
    tag.style.top  = ((-p.y*0.5 + 0.5)*innerHeight - 40) + 'px';
    tag.textContent = hovered.userData.isTap    ? (waterOn ? 'Turn it off' : 'Run the water')
                    : hovered.userData.isSwitch ? (lightsOn ? 'Lights off' : 'Lights on')
                    : hovered.userData.name;
    tag.classList.add('show');
  } else {
    tag.classList.remove('show');
  }
}

document.getElementById('notes').addEventListener('click', function(){ panel.classList.toggle('open'); });
document.getElementById('full').addEventListener('click', function(){
  if(document.fullscreenElement) document.exitFullscreen();
  else if(document.documentElement.requestFullscreen) document.documentElement.requestFullscreen();
});
addEventListener('keydown', function(e){
  if(e.key === 'Escape') panel.classList.remove('open');
  if(e.key === 'f' || e.key === 'F') document.getElementById('full').click();
  if(e.key === 'l' || e.key === 'L') toggleLights();
});

/* --- audio: the fridge, and the tap --- */
let actx = null, hum = null, humOn = false, waterGain = null;
function ensureAudio(){
  const AC = window.AudioContext || window.webkitAudioContext;
  if(!AC) return null;
  if(!actx) actx = new AC();
  if(actx.state === 'suspended') actx.resume();
  return actx;
}
function noiseBuffer(ctx){
  const n = ctx.sampleRate * 2;
  const buf = ctx.createBuffer(1, n, ctx.sampleRate);
  const d = buf.getChannelData(0);
  for(let i=0;i<n;i++) d[i] = Math.random()*2 - 1;
  return buf;
}
function waterSound(on){
  const ctx = ensureAudio(); if(!ctx) return;
  if(!waterGain){
    const src = ctx.createBufferSource();
    src.buffer = noiseBuffer(ctx); src.loop = true;
    const hp = ctx.createBiquadFilter(); hp.type = 'highpass'; hp.frequency.value = 900;
    const bp = ctx.createBiquadFilter(); bp.type = 'bandpass'; bp.frequency.value = 2400; bp.Q.value = 0.7;
    const g = ctx.createGain(); g.gain.value = 0;
    src.connect(hp); hp.connect(bp); bp.connect(g); g.connect(ctx.destination);
    src.start();
    waterGain = g;
  }
  waterGain.gain.linearRampToValueAtTime(on ? 0.055 : 0, ctx.currentTime + 0.18);
}
document.getElementById('sound').addEventListener('click', function(){
  const ctx = ensureAudio(); if(!ctx) return;
  if(!hum){
    const gain = ctx.createGain(); gain.gain.value = 0;
    const filt = ctx.createBiquadFilter(); filt.type = 'lowpass'; filt.frequency.value = 240;
    const o1 = ctx.createOscillator(); o1.type = 'sine'; o1.frequency.value = 58;
    const o2 = ctx.createOscillator(); o2.type = 'sine'; o2.frequency.value = 116;
    const lfo = ctx.createOscillator(); lfo.frequency.value = 0.09;
    const lg = ctx.createGain(); lg.gain.value = 3.5;
    lfo.connect(lg); lg.connect(o2.frequency);
    const rumble = ctx.createBufferSource();
    rumble.buffer = noiseBuffer(ctx); rumble.loop = true;
    const rf = ctx.createBiquadFilter(); rf.type = 'lowpass'; rf.frequency.value = 320;
    const rg = ctx.createGain(); rg.gain.value = 0.10;
    rumble.connect(rf); rf.connect(rg); rg.connect(gain);
    o1.connect(filt); o2.connect(filt); filt.connect(gain); gain.connect(ctx.destination);
    o1.start(); o2.start(); lfo.start(); rumble.start();
    hum = gain;
  }
  humOn = !humOn;
  hum.gain.linearRampToValueAtTime(humOn ? 0.055 : 0, ctx.currentTime + 0.7);
  this.setAttribute('aria-label', humOn ? 'Turn room tone off' : 'Turn room tone on');
  waves.forEach(function(w){ w.style.opacity = humOn ? 1 : 0.18; });
});

/* ============================================================
   15. LOOP
   ============================================================ */
const clock = new THREE.Clock();
const fwd = new THREE.Vector3(), lookAt = new THREE.Vector3();

function tick(){
  requestAnimationFrame(tick);
  const dt = Math.min(clock.getDelta(), 0.05);
  const t = clock.getElapsedTime();
  const k = Math.min(1, dt*4.2);

  look.x  += (target.x - look.x)*Math.min(1, dt*3.0);
  look.y  += (target.y - look.y)*Math.min(1, dt*3.0);
  yaw     += (yawT - yaw)*k;
  pitch   += (pitchT - pitch)*k;
  dolly   += (dollyT - dolly)*Math.min(1, dt*3.2);

  const ey = yaw   + look.x*0.085;              /* a little drift with the cursor */
  const ep = pitch + look.y*0.055;
  camera.position.set(
    HOME.x + look.x*0.14,
    HOME.y + look.y*0.04 + Math.sin(t*0.42)*0.011,
    HOME.z - dolly
  );
  const cp = Math.cos(ep);
  fwd.set(-Math.sin(ey)*cp, Math.sin(ep), -Math.cos(ey)*cp);
  lookAt.copy(camera.position).addScaledVector(fwd, 8);
  camera.lookAt(lookAt);

  updateHover();

  /* the lights come up and go down rather than snapping */
  lightLevel += ((lightsOn ? 1 : 0) - lightLevel) * Math.min(1, dt*4.5);
  const L = lightLevel;
  spots.forEach(function(s){ s.intensity = s.userData.base * (0.03 + 0.97*L); });
  hemi.intensity = 0.16 + 0.26*L;
  throughGap.intensity = 0.30 + 0.10*(1 - L);   /* the gap matters more in the dark */
  M.lens.emissiveIntensity = 0.04 + 1.75*L;
  const flick = 1 + Math.sin(t*7.3)*0.006;
  halos.forEach(function(h){ h.material.opacity = 0.34*L*flick; });
  pools.forEach(function(p){ p.material.opacity = p.userData.baseOpacity * L; });

  /* the tap */
  waterLevel += ((waterOn ? 1 : 0) - waterLevel) * Math.min(1, dt*9);
  const st = tap.userData.stream, sp = tap.userData.splash;
  st.visible = waterLevel > 0.02;
  sp.visible = st.visible;
  st.material.opacity = 0.62 * waterLevel;
  st.material.map.offset.y -= dt*5.2;
  sp.material.opacity = (0.30 + Math.sin(t*11)*0.05) * waterLevel;
  sp.scale.setScalar(0.85 + waterLevel*0.25 + Math.sin(t*9)*0.03);
  tap.userData.lever.rotation.x = -0.30 - waterLevel*0.42;

  /* the switch rockers tip over with the lights */
  switchPlate.userData.rockers.forEach(function(r){
    r.rotation.x = (0.16 - 0.32*L);
  });

  renderer.render(scene, camera);
}
tick();

addEventListener('resize', function(){
  renderer.setSize(innerWidth, innerHeight);
  frameCamera();
});

setTimeout(function(){ fadeEl.classList.add('hidden'); }, 220);

})();
</script>
</body>
</html>

/* a tiny stand-in interior, pre-filtered into an environment map.
   gives brass and glass something real to reflect. */
try{
  const pmrem = new THREE.PMREMGenerator(renderer);
  const env = new THREE.Scene();
  const shell = new THREE.Mesh(new THREE.BoxGeometry(10,10,10),
    new THREE.MeshBasicMaterial({color:0xc9bda4, side:THREE.BackSide}));
  env.add(shell);
  const win = new THREE.Mesh(new THREE.PlaneGeometry(4.6,5.4),
    new THREE.MeshBasicMaterial({color:0xfff3e0}));
  win.rotation.y = Math.PI/2; win.position.set(-4.9, 1.2, 1);
  env.add(win);
  const gnd = new THREE.Mesh(new THREE.PlaneGeometry(10,10),
    new THREE.MeshBasicMaterial({color:0x877962}));
  gnd.rotation.x = -Math.PI/2; gnd.position.y = -4.9;
  env.add(gnd);
  scene.environment = pmrem.fromScene(env, 0.05).texture;
  pmrem.dispose();
  scene.traverse(function(o){
    if(o.isMesh && o.material && o.material.isMeshStandardMaterial){
      o.material.envMapIntensity = o.material.metalness > 0.5 ? 1.15 : 0.4;
    }
  });
}catch(e){ /* environment is a bonus, not a requirement */ }

/* the light the window throws */
const goboTex = new THREE.CanvasTexture(goboCanvas());
function pool(w,h,opacity){
  return new THREE.Mesh(new THREE.PlaneGeometry(w,h),
    new THREE.MeshBasicMaterial({map:goboTex, color:0xffd9a1, transparent:true,
      opacity:opacity, blending:THREE.AdditiveBlending, depthWrite:false}));
}
const floorPool = pool(7.4, 9.4, 0.30);

/* ============================================================
   10. INTERACTION
   ============================================================ */
const dom = renderer.domElement;
const pointer = new THREE.Vector2(0,0);
const look = {x:0,y:0}, target = {x:0,y:0};
let dolly = 0, dollyTarget = 0, yaw = 0, pitch = 0;
let dragging = false, dragged = false, lastX = 0, lastY = 0;

const raycaster = new THREE.Raycaster();
let hovered = null;
const clickable = doors.concat([phone]);

const APPROACH = 4.6;
const walk = {state:'idle', t:0, from:new THREE.Vector3(), to:new THREE.Vector3(),
              lookFrom:new THREE.Vector3(), lookTo:new THREE.Vector3()};
const restLook = new THREE.Vector3(0, 2.05, BACK_Z);
const ORIGIN = HOME.clone();

function approach(door){
  const n = new THREE.Vector3(0,0,1).applyQuaternion(door.quaternion);
  walk.from.copy(camera.position);
  walk.to.copy(door.position).addScaledVector(n, APPROACH);
  walk.to.y = 1.9;
  walk.lookFrom.copy(restLook);
  walk.lookTo.copy(door.position).setY(1.86);

  /* a prop that is still inside the frame once we arrive cannot dissolve at
     the door without being watched doing it — on the left-wall door the table
     sits square on the sightline. those go early instead, over the fastest
     stretch of the move. everything else holds until the door fills the view. */
  const eye = walk.to.clone(), fwd = walk.lookTo.clone().sub(eye).normalize();
  props.forEach(function(pr){
    pr.obj.getWorldPosition(tmpV).sub(eye);
    const along = tmpV.dot(fwd), len = Math.max(1e-4, tmpV.length());
    pr.early = along > 0.2 &&
      Math.acos(THREE.MathUtils.clamp(along/len, -1, 1)) < H_HALF*1.3;
  });

  walk.t = 0; walk.state = 'in';
  tag.classList.remove('show');
  backBtn.classList.add('show');
  hideHint();
}
function stepBack(){
  if(walk.state !== 'at') return;
  walk.from.copy(camera.position);
  walk.to.copy(ORIGIN);
  walk.lookFrom.copy(walk.lookTo);
  walk.lookTo.copy(restLook);
  walk.t = 0; walk.state = 'out';
  backBtn.classList.remove('show');
}
backBtn.addEventListener('click', stepBack);

/* --- telephone --- */
let handsetUp = false, handsetY = 0;
function togglePhone(){
  handsetUp = !handsetUp;
  if(handsetUp) dialTone();
}

dom.style.cursor = 'grab';
dom.addEventListener('pointerdown', function(e){
  dragging = true; dragged = false;
  lastX = e.clientX; lastY = e.clientY;
  if(dom.setPointerCapture) dom.setPointerCapture(e.pointerId);
  dom.style.cursor = 'grabbing';
});
dom.addEventListener('pointermove', function(e){
  pointer.x =  (e.clientX/innerWidth)*2 - 1;
  pointer.y = -(e.clientY/innerHeight)*2 + 1;
  target.x = pointer.x; target.y = pointer.y;
  if(dragging){
    const dx = e.clientX-lastX, dy = e.clientY-lastY;
    if(Math.abs(dx)+Math.abs(dy) > 4) dragged = true;
    yaw   = THREE.MathUtils.clamp(yaw   - dx*0.0024, -0.75, 0.75);
    pitch = THREE.MathUtils.clamp(pitch - dy*0.0015, -0.14, 0.16);
    lastX = e.clientX; lastY = e.clientY;
    hideHint();
  }
});
function endDrag(){
  if(!dragging) return;
  dragging = false;
  dom.style.cursor = hovered ? 'pointer' : 'grab';
  if(dragged) return;
  if(walk.state === 'at'){ stepBack(); return; }
  if(hovered && walk.state === 'idle'){
    if(hovered.userData.isDoor) approach(hovered);
    else if(hovered.userData.isPhone) togglePhone();
  }
}
dom.addEventListener('pointerup', endDrag);
dom.addEventListener('pointercancel', endDrag);
dom.addEventListener('pointerleave', function(){ tag.classList.remove('show'); });
dom.addEventListener('wheel', function(e){
  if(walk.state !== 'idle') return;
  dollyTarget = THREE.MathUtils.clamp(dollyTarget - e.deltaY*0.0024, -2.0, 4.2);
  hideHint();
}, {passive:true});

function updateHover(){
  raycaster.setFromCamera(pointer, camera);
  const hit = raycaster.intersectObjects(clickable, true)[0];
  let group = null;
  if(hit){
    let o = hit.object;
    while(o && !o.userData.isDoor && !o.userData.isPhone) o = o.parent;
    group = o;
    if(group && group.userData.isPhone && phoneProp && phoneProp.shown < 0.4) group = null;
  }
  if(group !== hovered){
    hovered = group;
    dom.style.cursor = dragging ? 'grabbing' : (hovered ? 'pointer' : 'grab');
  }
  if(hovered && hit){
    const p = hit.point.clone().project(camera);
    tag.style.left = (( p.x*0.5+0.5)*innerWidth) + 'px';
    tag.style.top  = ((-p.y*0.5+0.5)*innerHeight - 40) + 'px';
    tag.textContent = hovered.userData.isPhone
      ? (handsetUp ? 'Hang up' : 'Pick up')
      : hovered.userData.name;
    tag.classList.add('show');
  } else {
    tag.classList.remove('show');
  }
}
const phoneProp = props.filter(function(p){ return p.obj === phone; })[0];

document.getElementById('notes').addEventListener('click', function(){ panel.classList.toggle('open'); });
document.getElementById('full').addEventListener('click', function(){
  if(document.fullscreenElement) document.exitFullscreen();
  else if(document.documentElement.requestFullscreen) document.documentElement.requestFullscreen();
});
addEventListener('keydown', function(e){
  if(e.key === 'Escape'){ panel.classList.remove('open'); stepBack(); }
  if(e.key === 'f' || e.key === 'F') document.getElementById('full').click();
});

/* --- audio: room tone + dial tone --- */
let actx = null, tone = null, toneOn = false;
function ensureAudio(){
  const AC = window.AudioContext || window.webkitAudioContext;
  if(!AC) return null;
  if(!actx) actx = new AC();
  if(actx.state === 'suspended') actx.resume();
  return actx;
}
function dialTone(){
  const ctx = ensureAudio(); if(!ctx) return;
  const g = ctx.createGain();
  g.gain.setValueAtTime(0, ctx.currentTime);
  g.gain.linearRampToValueAtTime(0.05, ctx.currentTime + 0.05);
  g.gain.setValueAtTime(0.05, ctx.currentTime + 1.6);
  g.gain.linearRampToValueAtTime(0, ctx.currentTime + 2.0);
  g.connect(ctx.destination);
  [350, 440].forEach(function(f){
    const o = ctx.createOscillator();
    o.type = 'sine'; o.frequency.value = f;
    o.connect(g); o.start();
    o.stop(ctx.currentTime + 2.1);
  });
}
document.getElementById('sound').addEventListener('click', function(){
  const ctx = ensureAudio(); if(!ctx) return;
  if(!tone){
    const gain = ctx.createGain(); gain.gain.value = 0;
    const filt = ctx.createBiquadFilter(); filt.type='lowpass'; filt.frequency.value = 300;
    const o1 = ctx.createOscillator(); o1.type='sine'; o1.frequency.value = 66;
    const o2 = ctx.createOscillator(); o2.type='sine'; o2.frequency.value = 99;
    const lfo = ctx.createOscillator(); lfo.frequency.value = 0.06;
    const lg = ctx.createGain(); lg.gain.value = 5;
    lfo.connect(lg); lg.connect(o2.frequency);
    o1.connect(filt); o2.connect(filt); filt.connect(gain); gain.connect(ctx.destination);
    o1.start(); o2.start(); lfo.start();
    tone = gain;
  }
  toneOn = !toneOn;
  tone.gain.linearRampToValueAtTime(toneOn ? 0.045 : 0, ctx.currentTime + 0.8);
  this.setAttribute('aria-label', toneOn ? 'Turn room tone off' : 'Turn room tone on');
  waves.forEach(function(w){ w.style.opacity = toneOn ? 1 : 0.18; });
});

/* ============================================================
   11. LOOP
   ============================================================ */
const lookAt = new THREE.Vector3();
const clock = new THREE.Clock();
const tmpV = new THREE.Vector3();
let hoverGlow = 0;

function easeInOut(p){ return p < 0.5 ? 2*p*p : 1 - Math.pow(-2*p + 2, 2)/2; }

/* props clear out of an approach so nothing crosses the door — but the
   visitor should never catch them going. the veil holds at 0 for the whole
   walk across the room and only closes over the last few frames, once the
   door already fills the frame; stepping back releases it immediately, so
   they are back before the camera has pulled far enough to see them arrive. */
let veil = 0, veilEarly = 0;
function updateVeil(dt){
  const ss = THREE.MathUtils.smoothstep;
  if(walk.state === 'in'){
    veil      = ss(walk.t, 0.80, 0.97);
    veilEarly = ss(walk.t, 0.08, 0.46);
  } else if(walk.state === 'at'){
    veil = veilEarly = 1;
  } else if(walk.state === 'out'){          /* both release the moment we pull away */
    veil      = 1 - ss(walk.t, 0.00, 0.30);
    veilEarly = 1 - ss(walk.t, 0.00, 0.55);
  } else {
    const k = Math.min(1, dt*4.0);
    veil -= veil*k; veilEarly -= veilEarly*k;
  }
}

/* and independently of all that, a prop dissolves when the camera closes on it */
function updateProps(dt){
  props.forEach(function(p){
    p.obj.getWorldPosition(tmpV);
    const d = camera.position.distanceTo(tmpV);
    const want = THREE.MathUtils.clamp((d - 1.5)/1.9, 0, 1);
    p.o += (want - p.o) * Math.min(1, dt*4.5);
    const o = p.shown = p.o * (1 - (p.early ? veilEarly : veil));
    p.obj.visible = o > 0.012;
    p.mats.forEach(function(m){
      const base = m.userData.baseOpacity === undefined ? 1 : m.userData.baseOpacity;
      m.opacity = base * o;
      if(m.userData.opaqueBase) m.depthWrite = o > 0.985;
    });
    if(p.light) p.light.intensity = p.baseI * o;
  });
}

function tick(){
  requestAnimationFrame(tick);
  const dt = Math.min(clock.getDelta(), 0.05);
  const t = clock.getElapsedTime();

  /* handset */
  const wantY = handsetUp ? 0.17 : 0;
  handsetY += (wantY - handsetY) * Math.min(1, dt*7);
  if(Math.abs(handset.position.y - (HANDSET_Y + handsetY)) > 0.0006){
    handset.position.y = HANDSET_Y + handsetY;
    handset.rotation.z = -handsetY * 1.5;
    restringCord();
  }

  if(walk.state === 'in' || walk.state === 'out'){
    walk.t = Math.min(1, walk.t + dt/1.5);
    const e = easeInOut(walk.t);
    camera.position.lerpVectors(walk.from, walk.to, e);
    lookAt.lerpVectors(walk.lookFrom, walk.lookTo, e);
    camera.lookAt(lookAt);
    if(walk.t >= 1){
      if(walk.state === 'out'){
        walk.state = 'idle';
        HOME.copy(ORIGIN);
        yaw = pitch = 0; dolly = dollyTarget = 0;
        look.x = look.y = target.x = target.y = 0;
      } else {
        walk.state = 'at';
      }
    }
  } else if(walk.state === 'at'){
    camera.position.copy(walk.to);
    camera.lookAt(walk.lookTo);
  } else {
    const k = Math.min(1, dt*3.0);
    look.x += (target.x - look.x)*k;
    look.y += (target.y - look.y)*k;
    dolly  += (dollyTarget - dolly)*Math.min(1, dt*3.2);
    camera.position.set(
      HOME.x + look.x*0.42 + yaw*2.6,
      HOME.y + look.y*0.16 + pitch*2.0 + Math.sin(t*0.4)*0.014,
      HOME.z - dolly
    );
    lookAt.set(look.x*0.8 + yaw*1.9, 1.98 + look.y*0.26 + pitch*1.5, BACK_Z);
    camera.lookAt(lookAt);
    updateHover();
  }

  updateVeil(dt);
  updateProps(dt);

  /* the hovered door warms very slightly, as if catching more light */
  const wantGlow = (hovered && hovered.userData.isDoor) ? 1 : 0;
  hoverGlow += (wantGlow - hoverGlow) * Math.min(1, dt*6);
  doors.forEach(function(d){
    const on = (d === hovered) ? hoverGlow : 0;
    d.userData.faces.forEach(function(f){
      f.emissive.setRGB(0.10, 0.075, 0.04);
      f.emissiveIntensity = on * 0.32;
    });
  });

  renderer.render(scene, camera);
}
tick();

addEventListener('resize', function(){
  renderer.setSize(innerWidth, innerHeight);
  frameCamera();
});

setTimeout(function(){ fadeEl.classList.add('hidden'); }, 220);

})();
</script>
</body>
</html>
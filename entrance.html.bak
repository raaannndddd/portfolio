floorPool.position.set(1.4, 0.02, -1.6); floorPool.renderOrder = 3;
scene.add(floorPool);

const wallPool = pool(4.6, 4.0, 0.19);
wallPool.rotation.y = -Math.PI/2;
wallPool.position.set(SIDE_X - 0.16, 3.3, -0.2); wallPool.renderOrder = 3;
scene.add(wallPool);


});

/* handset: one moulded piece — a grip that swells into a cup at each end */
const HANDSET_Y = 0.162;
const handset = new THREE.Group();
const bar = new THREE.CatmullRomCurve3([
  new THREE.Vector3(-0.188, 0.044, 0),
  new THREE.Vector3(-0.100, 0.092, 0),
  new THREE.Vector3( 0.000, 0.104, 0),
  new THREE.Vector3( 0.100, 0.092, 0),
  new THREE.Vector3( 0.188, 0.044, 0)
]);
handset.add(new THREE.Mesh(sweep(bar, 48, 18, function(t){
  return 0.0175 + 0.013*Math.pow(Math.abs(t-0.5)*2, 2.6);
}), bakeliteM));
[-1,1].forEach(function(s){
  const cup = new THREE.Mesh(turned([
    [0.046,0.000],[0.056,0.002],[0.061,0.009],[0.060,0.019],[0.052,0.033],
    [0.043,0.047],[0.036,0.060],[0.000,0.062]
  ], 32), bakeliteM);
  cup.position.set(s*0.186, 0.000, 0);
  handset.add(cup);
  const grille = new THREE.Mesh(new THREE.CircleGeometry(0.047, 28), bakeDarkM);
  grille.rotation.x = Math.PI/2;
  grille.position.set(s*0.186, 0.004, 0);
  handset.add(grille);
});
handset.position.y = HANDSET_Y;
phone.add(handset);

/* the coiled cord — the one detail that reads as "telephone" from across the
   room. it is restrung whenever the handset moves, so the coil follows it. */
const cordM = new THREE.MeshStandardMaterial({color:'#3d6579', roughness:0.6});
const CORD_PORT = new THREE.Vector3(-0.176, 0.046, -0.112);
let cord = null;
function cordPath(end){
  /* the cord leaves the back of the case, loops out clear of it on the table,
     then climbs to the handset — a helix wound around that spine */
  const spine = new THREE.CatmullRomCurve3([
    CORD_PORT.clone(),
    new THREE.Vector3(-0.286, 0.028, -0.126),
    new THREE.Vector3(-0.330, 0.026,  0.004),
    end.clone()
  ]);
  const pts = [], n = 132, turns = 6, up = new THREE.Vector3(0,1,0);
  const c = new THREE.Vector3(), tan = new THREE.Vector3(),
        u = new THREE.Vector3(), v = new THREE.Vector3();
  for(let i=0;i<=n;i++){
    const t = i/n;
    spine.getPointAt(t, c);
    spine.getTangentAt(t, tan);
    u.crossVectors(tan, up);
    if(u.lengthSq() < 1e-8) u.set(1,0,0);
    u.normalize();
    v.crossVectors(u, tan).normalize();
    const env = Math.pow(Math.sin(Math.PI*t), 0.45);     /* the coil dies into both ends */
    const a = t*turns*Math.PI*2, r = 0.026*env;
    pts.push(new THREE.Vector3(
      c.x + (u.x*Math.cos(a) + v.x*Math.sin(a))*r,
      c.y + (u.y*Math.cos(a) + v.y*Math.sin(a))*r,
      c.z + (u.z*Math.cos(a) + v.z*Math.sin(a))*r
    ));
  }
  return new THREE.CatmullRomCurve3(pts);
}
function restringCord(){
  const end = new THREE.Vector3(-0.196, 0.020, 0)
    .applyAxisAngle(new THREE.Vector3(0,0,1), handset.rotation.z)
    .add(new THREE.Vector3(0, handset.position.y, 0));
  const geo = sweep(cordPath(end), 132, 8, function(){ return 0.0092; });
  if(cord){ cord.geometry.dispose(); cord.geometry = geo; }
  else {
    cord = new THREE.Mesh(geo, cordM);
    cord.castShadow = true;
    phone.add(cord);
  }
}
restringCord();

phone.traverse(function(o){ if(o.isMesh){ o.castShadow = true; o.receiveShadow = true; } });
phone.position.set(TABLE.x - 0.36, 1.015, TABLE.z + 0.32);
phone.rotation.y = 0.5;
phone.userData.isPhone = true;
phone.userData.name = 'Telephone';
scene.add(phone);
registerProp(phone, [bakeliteM, bakeDarkM, chromeM, dialM, cordM]);


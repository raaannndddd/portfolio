<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>Salon Ocre — five doors</title>
<style>
  :root{
    --ink:#1c1a17;
    --card:#fffdf9;
    --shadow:0 8px 30px rgba(28,22,14,.20);
    --radius:14px;
  }
  *{box-sizing:border-box}
  html,body{height:100%;width:100%;margin:0;padding:0;background:#0e0c09;overflow:hidden}
  body{
    font-family:"Helvetica Neue",Inter,system-ui,-apple-system,"Segoe UI",sans-serif;
    color:var(--ink);-webkit-font-smoothing:antialiased;
  }
  #stage{position:fixed;inset:0;width:100vw;height:100vh}
  canvas{display:block;width:100%;height:100%;touch-action:none}

  /* lens pass */
  .lens{position:fixed;inset:0;pointer-events:none;z-index:3}
  #vignette{background:radial-gradient(122% 92% at 50% 46%,
      rgba(0,0,0,0) 40%, rgba(34,26,16,.18) 73%, rgba(22,16,9,.46) 100%);}
  #bloom{background:radial-gradient(62% 72% at 6% 16%, rgba(255,226,182,.17), rgba(255,226,182,0) 60%);
         mix-blend-mode:screen;}
  #grain{opacity:.05;mix-blend-mode:overlay;
    background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3'/></filter><rect width='180' height='180' filter='url(%23n)'/></svg>");}

  /* hud */
  .hud{position:fixed;inset:0;pointer-events:none;z-index:5}
  .hud > *{pointer-events:auto}
  .pill{
    position:absolute;background:var(--card);border-radius:var(--radius);
    box-shadow:var(--shadow);border:0;color:var(--ink);
    display:flex;align-items:center;gap:10px;
    font-size:15px;letter-spacing:.01em;font-family:inherit;
    padding:12px 16px;cursor:pointer;
    transition:transform .25s cubic-bezier(.2,.8,.2,1);
  }
  .pill:hover{transform:translateY(-2px)}
  .pill:active{transform:translateY(0)}
  .pill:focus-visible{outline:2px solid #1c1a17;outline-offset:3px}
  .square{padding:12px;width:46px;height:46px;justify-content:center}

  #plaque{top:22px;left:22px;cursor:default}
  #plaque:hover{transform:none}
  #plaque b{font-weight:600}
  #plaque span{color:#8c8375}
  #notes{top:22px;right:22px}
  #sound{bottom:22px;right:22px}
  #full{bottom:22px;right:80px}
  #back{bottom:22px;left:50%;transform:translateX(-50%);opacity:0;pointer-events:none;
        transition:opacity .3s, transform .25s cubic-bezier(.2,.8,.2,1)}
  #back.show{opacity:1;pointer-events:auto}
  #back.show:hover{transform:translateX(-50%) translateY(-2px)}

  #hint{
    position:absolute;left:50%;bottom:26px;transform:translateX(-50%);
    font-size:11.5px;letter-spacing:.16em;text-transform:uppercase;
    color:#efe6d6;text-shadow:0 1px 10px rgba(0,0,0,.6);
    white-space:nowrap;transition:opacity .8s;
  }
  #hint.gone{opacity:0}

  #panel{
    position:absolute;top:80px;right:22px;width:272px;background:var(--card);
    border-radius:var(--radius);box-shadow:var(--shadow);padding:18px 20px;
    opacity:0;transform:translateY(-8px) scale(.98);pointer-events:none;
    transition:opacity .28s, transform .28s cubic-bezier(.2,.8,.2,1);
  }
  #panel.open{opacity:1;transform:none;pointer-events:auto}
  #panel h2{margin:0 0 10px;font-size:11.5px;letter-spacing:.17em;text-transform:uppercase;font-weight:600}
  #panel p{margin:0;font-size:13.5px;line-height:1.55;color:#3c3730}
  #panel dl{margin:14px 0 0;font-size:13px;line-height:1.65;color:#3c3730}
  #panel dt{float:left;clear:left;width:112px;color:#8c8375}
  #panel dd{margin:0 0 0 112px}

  #tag{
    position:absolute;left:0;top:0;transform:translate(-50%,-50%);
    background:var(--card);border-radius:999px;padding:8px 15px;
    font-size:11.5px;letter-spacing:.13em;text-transform:uppercase;
    box-shadow:var(--shadow);opacity:0;transition:opacity .18s;
    pointer-events:none;white-space:nowrap;z-index:6;
  }
  #tag.show{opacity:1}

  #fade{position:fixed;inset:0;background:#0e0c09;z-index:9;
        transition:opacity .8s ease;pointer-events:none}
  #fade.hidden{opacity:0}

  @media (max-width:820px){
    #plaque{top:14px;left:14px;font-size:13px}
    #notes{top:14px;right:14px}
    #sound{bottom:14px;right:14px}#full{bottom:14px;right:70px}
    #panel{right:12px;width:calc(100vw - 24px);max-width:280px}
    #hint{font-size:10px;letter-spacing:.1em;bottom:74px}
  }
  @media (prefers-reduced-motion:reduce){*{transition-duration:.01ms !important}}
</style>
</head>
<body>

<div id="stage"></div>
<div class="lens" id="vignette"></div>
<div class="lens" id="bloom"></div>
<div class="lens" id="grain"></div>

<div class="hud">
  <div class="pill" id="plaque">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#1c1a17" stroke-width="1.7" stroke-linecap="round">
      <rect x="4" y="10.5" width="16" height="10" rx="2.5"/><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"/>
    </svg>
    <b>Salon Ocre</b><span>&nbsp;5 doors</span>
  </div>

  <button class="pill square" id="notes" aria-label="About this room">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1c1a17" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H19v14H6.5A2.5 2.5 0 0 0 4 19.5z"/><path d="M14.5 7.5 19 3"/>
    </svg>
  </button>

  <button class="pill square" id="full" aria-label="Enter fullscreen">
    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#1c1a17" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 9V4h5"/><path d="M20 9V4h-5"/><path d="M4 15v5h5"/><path d="M20 15v5h-5"/>
    </svg>
  </button>

  <button class="pill square" id="sound" aria-label="Turn room tone on">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1c1a17" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <path d="M5 9.5h3.5L13 5.5v13L8.5 14.5H5z"/>
      <path class="wave" d="M16.5 9.5a4 4 0 0 1 0 5"/>
      <path class="wave" d="M19 7a7.5 7.5 0 0 1 0 10"/>
    </svg>
  </button>

  <button class="pill" id="back">
    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#1c1a17" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <path d="M10 6 4 12l6 6"/><path d="M4 12h16"/>
    </svg>
    Step back
  </button>

  <div id="hint">Drag to look · Scroll to step · Click a door</div>
  <div id="tag"></div>

  <div id="panel">
    <h2>This room</h2>
    <p>Late afternoon, one window off to the left. Five doors, each painted a different pigment straight over raw trim.</p>
    <dl>
      <dt>Drag</dt><dd>Look around</dd>
      <dt>Scroll</dt><dd>Step forward and back</dd>
      <dt>Click a door</dt><dd>Approach it</dd>
      <dt>Click the phone</dt><dd>Pick up</dd>
    </dl>
  </div>
</div>

<div id="fade"></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
(function(){
"use strict";
if(!window.THREE) return;

/* ============================================================
   0. HUD
   ============================================================ */
const panel  = document.getElementById('panel');
const hintEl = document.getElementById('hint');
const tag    = document.getElementById('tag');
const fadeEl = document.getElementById('fade');
const backBtn= document.getElementById('back');
const waves  = document.querySelectorAll('.wave');
waves.forEach(function(w){ w.style.opacity = 0.18; });
let hintHidden = false;
function hideHint(){ if(!hintHidden){ hintHidden = true; hintEl.classList.add('gone'); } }

/* ============================================================
   1. PALETTE
   ============================================================ */
const P = {
  trim:    '#d8ccb4',
  plaster: '#efe7d8',
  dado:    '#e2d8c3',
  carpet:  '#c6b89c',
  wood:    '#6b4a33',
  doors:   ['#4f7f74', '#b0513a', '#2f4f6d', '#c39338', '#8a5a72']
};

/* ============================================================
   2. RENDERER / CAMERA
   ============================================================ */
const renderer = new THREE.WebGLRenderer({antialias:true, powerPreference:'high-performance'});
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
renderer.setSize(innerWidth, innerHeight);
renderer.outputEncoding = THREE.sRGBEncoding;
renderer.toneMapping = THREE.ACESFilmicToneMapping;
renderer.toneMappingExposure = 1.08;
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;
document.getElementById('stage').appendChild(renderer.domElement);
const ANISO = renderer.capabilities.getMaxAnisotropy();

const scene = new THREE.Scene();
scene.background = new THREE.Color('#e6dcc9');
scene.fog = new THREE.Fog(0xe9dfcb, 28, 66);

const BACK_Z = -7, SIDE_X = 6, WALL_H = 6.6, FRONT_Z = 9;
const SIDE_LEN = FRONT_Z - BACK_Z, SIDE_MID = (BACK_Z + FRONT_Z)/2;
const HOME = new THREE.Vector3(0, 1.85, 7.2);

const camera = new THREE.PerspectiveCamera(42, innerWidth/innerHeight, 0.1, 200);
camera.position.copy(HOME);

const H_HALF = 30 * Math.PI/180;                 /* constant horizontal FOV */
function frameCamera(){
  camera.aspect = innerWidth / innerHeight;
  const v = 2 * Math.atan(Math.tan(H_HALF) / camera.aspect) * 180/Math.PI;
  camera.fov = THREE.MathUtils.clamp(v, 24, 54);
  camera.updateProjectionMatrix();
}
frameCamera();

/* ============================================================
   3. TEXTURE FOUNDRY
   ============================================================ */
function cvs(w,h){ const c = document.createElement('canvas'); c.width=w; c.height=h; return c; }
function tex(canvas, rx, ry){
  const t = new THREE.CanvasTexture(canvas);
  t.encoding = THREE.sRGBEncoding;
  t.anisotropy = ANISO;
  if(rx){ t.wrapS = t.wrapT = THREE.RepeatWrapping; t.repeat.set(rx, ry || rx); }
  return t;
}
function shift(hex, dL, dS){
  const c = new THREE.Color(hex), hsl = {};
  c.getHSL(hsl);
  c.setHSL(hsl.h, THREE.MathUtils.clamp(hsl.s + (dS||0), 0, 1),
                  THREE.MathUtils.clamp(hsl.l + dL, 0.02, 0.98));
  return '#' + c.getHexString();
}
function rgba(hex, a){
  const c = new THREE.Color(hex);
  return 'rgba(' + Math.round(c.r*255) + ',' + Math.round(c.g*255) + ',' + Math.round(c.b*255) + ',' + a + ')';
}
function blotch(g, w, h, base, count, spread, alpha){
  for(let i=0;i<count;i++){
    const x = Math.random()*w, y = Math.random()*h;
    const r = (0.04 + Math.random()*0.22) * Math.max(w,h) * spread;
    const c = shift(base, (Math.random()-0.5)*0.10, (Math.random()-0.5)*0.06);
    const grd = g.createRadialGradient(x,y,0,x,y,r);
    grd.addColorStop(0, rgba(c, alpha));
    grd.addColorStop(1, rgba(c, 0));
    g.fillStyle = grd; g.fillRect(x-r, y-r, r*2, r*2);
  }
}
function speckle(g, w, h, count, alpha){
  for(let i=0;i<count;i++){
    g.fillStyle = 'rgba(50,40,26,' + (Math.random()*alpha).toFixed(3) + ')';
    g.fillRect(Math.random()*w, Math.random()*h, 1.6, 1.1);
  }
}
/* linear black gradient, used to bake occlusion into a map */
function ao(g, w, h, x0,y0,x1,y1, a){
  const d = g.createLinearGradient(x0,y0,x1,y1);
  d.addColorStop(0, 'rgba(44,32,18,' + a + ')');
  d.addColorStop(1, 'rgba(44,32,18,0)');
  g.fillStyle = d; g.fillRect(0,0,w,h);
}

function plasterCanvas(w, h, o){
  o = o || {};
  const c = cvs(w,h), g = c.getContext('2d');
  g.fillStyle = P.plaster; g.fillRect(0,0,w,h);
  blotch(g, w, h, P.plaster, 95, 1.0, 0.5);
  blotch(g, w, h, shift(P.plaster,-0.05), 45, 0.5, 0.3);
  g.globalAlpha = 0.06; g.lineCap = 'round';
  for(let i=0;i<70;i++){                                   /* trowel drag */
    g.strokeStyle = shift(P.plaster, (Math.random()-0.5)*0.14);
    g.lineWidth = 2 + Math.random()*14;
    const x = Math.random()*w, y = Math.random()*h;
    g.beginPath(); g.moveTo(x,y);
    g.lineTo(x + (Math.random()-0.5)*w*0.28, y + (Math.random()-0.5)*h*0.12); g.stroke();
  }
  g.globalAlpha = 1;
  speckle(g, w, h, Math.round(w*h/900), 0.045);
  if(o.bottom) ao(g, w, h, 0, h, 0, h*(1-o.bottom), 0.36);
  if(o.top)    ao(g, w, h, 0, 0, 0, h*o.top, 0.32);
  if(o.left)   ao(g, w, h, 0, 0, w*o.left, 0, 0.38);
  if(o.right)  ao(g, w, h, w, 0, w*(1-o.right), 0, 0.38);
  return c;
}

/* dado carries the shadow the chair rail throws down its face */
function dadoCanvas(){
  const w = 512, h = 256, c = cvs(w,h), g = c.getContext('2d');
  g.fillStyle = P.dado; g.fillRect(0,0,w,h);
  blotch(g, w, h, P.dado, 50, 0.8, 0.45);
  speckle(g, w, h, 900, 0.05);
  ao(g, w, h, 0, 0, 0, h*0.26, 0.40);        /* under the rail */
  ao(g, w, h, 0, h, 0, h*0.80, 0.22);        /* at the skirting */
  return c;
}

function trimCanvas(){
  const w = 256, h = 256, c = cvs(w,h), g = c.getContext('2d');
  g.fillStyle = P.trim; g.fillRect(0,0,w,h);
  blotch(g, w, h, P.trim, 34, 0.8, 0.5);
  g.globalAlpha = 0.14;                      /* faint brush lay-off */
  for(let i=0;i<90;i++){
    g.strokeStyle = shift(P.trim, (Math.random()-0.5)*0.12);
    g.lineWidth = 0.8 + Math.random()*3;
    const y = Math.random()*h;
    g.beginPath(); g.moveTo(0,y); g.lineTo(w, y + (Math.random()-0.5)*6); g.stroke();
  }
  g.globalAlpha = 1;
  speckle(g, w, h, 700, 0.05);
  return c;
}

function carpetCanvas(){
  const w = 512, h = 512, c = cvs(w,h), g = c.getContext('2d');
  g.fillStyle = P.carpet; g.fillRect(0,0,w,h);
  blotch(g, w, h, P.carpet, 60, 0.7, 0.4);
  g.globalAlpha = 0.10;
  for(let i=0;i<3000;i++){
    g.strokeStyle = shift(P.carpet, (Math.random()-0.5)*0.22);
    g.lineWidth = 1 + Math.random()*1.6;
    const x = Math.random()*w, y = Math.random()*h;
    g.beginPath(); g.moveTo(x,y); g.lineTo(x + (Math.random()-0.5)*7, y + (Math.random()-0.5)*7); g.stroke();
  }
  g.globalAlpha = 1;
  speckle(g, w, h, 2400, 0.05);
  return c;
}

function woodCanvas(){
  const w = 512, h = 512, c = cvs(w,h), g = c.getContext('2d');
  g.fillStyle = P.wood; g.fillRect(0,0,w,h);
  for(let i=0;i<150;i++){
    g.strokeStyle = shift(P.wood, (Math.random()-0.5)*0.16);
    g.globalAlpha = 0.16 + Math.random()*0.3;
    g.lineWidth = 0.7 + Math.random()*3.2;
    const y = Math.random()*h;
    g.beginPath(); g.moveTo(0,y);
    g.bezierCurveTo(w*0.33, y+(Math.random()-0.5)*26, w*0.66, y+(Math.random()-0.5)*26, w, y+(Math.random()-0.5)*14);
    g.stroke();
  }
  g.globalAlpha = 1;
  return c;
}

function paintCanvas(w, h, color){
  const c = cvs(w,h), g = c.getContext('2d');
  g.fillStyle = P.trim; g.fillRect(0,0,w,h);
  speckle(g, w, h, Math.round(w*h/260), 0.05);
  const pad = Math.min(w,h)*0.07;
  g.lineCap = 'round';
  for(let i=0, n=Math.max(60, Math.round(w*h/1800)); i<n; i++){
    const x  = pad + Math.random()*(w - pad*2);
    const y0 = pad*0.3 + Math.random()*(h - pad);
    const len = h*0.08 + Math.random()*h*0.44;
    const y1 = Math.min(h - pad*0.3, y0 + len);
    const j = function(){ return (Math.random()-0.5)*w*0.03; };
    g.globalAlpha = 0.13 + Math.random()*0.5;
    g.strokeStyle = shift(color, (Math.random()-0.5)*0.17, (Math.random()-0.5)*0.12);
    g.lineWidth = w*0.03 + Math.random()*w*0.09;
    g.beginPath(); g.moveTo(x + j(), y0);
    g.bezierCurveTo(x + j(), y0 + len*0.33, x + j(), y0 + len*0.66, x + j(), y1);
    g.stroke();
  }
  for(let i=0, n=Math.max(5, Math.round(w/56)); i<n; i++){
    const x = Math.random()*w;
    g.globalAlpha = 0.10 + Math.random()*0.24;
    g.strokeStyle = P.trim;
    g.lineWidth = w*0.012 + Math.random()*w*0.045;
    g.beginPath(); g.moveTo(x, Math.random()*h*0.4);
    g.lineTo(x + (Math.random()-0.5)*w*0.1, h*(0.5 + Math.random()*0.5)); g.stroke();
  }
  g.globalAlpha = 1;
  const foot = g.createLinearGradient(0, h, 0, h*0.8);
  foot.addColorStop(0, 'rgba(48,36,22,.3)'); foot.addColorStop(1, 'rgba(48,36,22,0)');
  g.fillStyle = foot; g.fillRect(0,0,w,h);
  return c;
}

function radialCanvas(inner, mid){
  const s = 256, c = cvs(s,s), g = c.getContext('2d');
  const grd = g.createRadialGradient(s/2,s/2,0,s/2,s/2,s/2);
  grd.addColorStop(0, 'rgba(255,255,255,' + inner + ')');
  grd.addColorStop(mid || 0.45, 'rgba(255,255,255,' + (inner*0.5) + ')');
  grd.addColorStop(1, 'rgba(255,255,255,0)');
  g.fillStyle = grd; g.fillRect(0,0,s,s);
  return c;
}

function goboCanvas(){
  const w = 512, h = 512, c = cvs(w,h), g = c.getContext('2d');
  g.fillStyle = '#000'; g.fillRect(0,0,w,h);
  g.filter = 'blur(16px)'; g.fillStyle = '#fff';
  const px = 54, py = 74, pw = (w - px*2 - 26)/2, ph = h - py*2;
  g.fillRect(px, py, pw, ph);
  g.fillRect(px + pw + 26, py, pw, ph);
  g.filter = 'none';
  const grd = g.createRadialGradient(w/2,h/2,w*0.18,w/2,h/2,w*0.56);
  grd.addColorStop(0,'rgba(0,0,0,0)'); grd.addColorStop(1,'rgba(0,0,0,1)');
  g.globalCompositeOperation = 'multiply';
  g.fillStyle = grd; g.fillRect(0,0,w,h);
  return c;
}

/* ============================================================
   4. MATERIALS
   ============================================================ */
const carpetTex = tex(carpetCanvas(), 14, 14);
const woodTex   = tex(woodCanvas());
const trimTex   = tex(trimCanvas(), 3, 3);
const dadoTex   = tex(dadoCanvas());

const M = {
  trim:    new THREE.MeshStandardMaterial({map:trimTex, bumpMap:trimTex, bumpScale:0.004, roughness:0.84}),
  dado:    new THREE.MeshStandardMaterial({map:dadoTex, bumpMap:dadoTex, bumpScale:0.005, roughness:0.95}),
  carpet:  new THREE.MeshStandardMaterial({map:carpetTex, bumpMap:carpetTex, bumpScale:0.014,
                                           roughnessMap:carpetTex, roughness:1}),
  ceiling: new THREE.MeshStandardMaterial({color:'#f7f2e6', roughness:1}),
  wood:    new THREE.MeshStandardMaterial({map:woodTex, bumpMap:woodTex, bumpScale:0.004,
                                           roughness:0.4, metalness:0.05}),
  brass:   new THREE.MeshStandardMaterial({color:'#c9a763', roughness:0.26, metalness:0.92}),
  shade:   new THREE.MeshStandardMaterial({color:'#a5382f', roughness:0.9, side:THREE.DoubleSide,
                                           emissive:'#c2492f', emissiveIntensity:0.8}),
  phone:   new THREE.MeshStandardMaterial({color:'#5f8ea8', roughness:0.34}),
  glass:   new THREE.MeshStandardMaterial({color:'#ffffff', roughness:0.05,
                                           transparent:true, opacity:0.22, side:THREE.DoubleSide}),
  ceramic: new THREE.MeshStandardMaterial({color:'#cdbda2', roughness:0.5})
};

/* ============================================================
   5. HELPERS
   ============================================================ */
function box(w,h,d,mat,x,y,z){
  const m = new THREE.Mesh(new THREE.BoxGeometry(w,h,d), mat);
  m.position.set(x||0,y||0,z||0);
  m.castShadow = true; m.receiveShadow = true;
  return m;
}
function roundedGeo(w,h,d,r){
  r = Math.min(r, w/2-0.002, h/2-0.002);
  const s = new THREE.Shape(), x = -w/2, y = -h/2;
  s.moveTo(x+r,y);
  s.lineTo(x+w-r,y);   s.quadraticCurveTo(x+w,y,x+w,y+r);
  s.lineTo(x+w,y+h-r); s.quadraticCurveTo(x+w,y+h,x+w-r,y+h);
  s.lineTo(x+r,y+h);   s.quadraticCurveTo(x,y+h,x,y+h-r);
  s.lineTo(x,y+r);     s.quadraticCurveTo(x,y,x+r,y);
  const g = new THREE.ExtrudeGeometry(s,{depth:Math.max(0.02,d-0.05), bevelEnabled:true,
    bevelSize:0.022, bevelThickness:0.022, bevelSegments:3, curveSegments:6});
  g.center();
  return g;
}
function soft(w,h,d,r,mat,x,y,z){
  const m = new THREE.Mesh(roundedGeo(w,h,d,r), mat);
  m.position.set(x||0,y||0,z||0);
  m.castShadow = true; m.receiveShadow = true;
  return m;
}
function moulding(w,h,t,d,mat){
  const g = new THREE.Group();
  g.add(box(w,t,d,mat,0, h/2-t/2,0));
  g.add(box(w,t,d,mat,0,-h/2+t/2,0));
  g.add(box(t,h-t*2,d,mat,-w/2+t/2,0,0));
  g.add(box(t,h-t*2,d,mat, w/2-t/2,0,0));
  return g;
}
function contact(size, opacity, x, z){
  const t = new THREE.CanvasTexture(radialCanvas(1, 0.20));
  const m = new THREE.Mesh(new THREE.PlaneGeometry(size,size),
    new THREE.MeshBasicMaterial({map:t, color:0x2a1f12, transparent:true,
      opacity:opacity, depthWrite:false}));
  m.rotation.x = -Math.PI/2;
  m.position.set(x, 0.012, z);
  m.renderOrder = 2;
  m.userData.baseOpacity = opacity;
  return m;
}

/* ============================================================
   6. DOORS — larger, and set proud of every wall band
   ============================================================ */
const DOOR_W = 1.46, DOOR_H = 3.62, CASE_T = 0.18, REVEAL = 0.045;
const DOOR_HALF = DOOR_W/2 + REVEAL + CASE_T;

function paintedSlab(w,h,d,color){
  const th = THREE.MathUtils.clamp(Math.round(384*h/w), 96, 1200);
  const map = tex(paintCanvas(384, th, color));
  const face = new THREE.MeshStandardMaterial({map:map, bumpMap:map, bumpScale:0.007, roughness:0.7});
  const edge = new THREE.MeshStandardMaterial({map:trimTex, roughness:0.86});
  const m = new THREE.Mesh(new THREE.BoxGeometry(w,h,d), [edge,edge,edge,edge,face,edge]);
  m.castShadow = true; m.receiveShadow = true;
  m.userData.face = face;
  return m;
}

function makeDoor(color, name){
  const g = new THREE.Group();
  const faces = [];

  /* dark shadow gap, sitting proud of the plaster so the leaf reads as recessed */
  const gapH = DOOR_H + REVEAL;
  const gap = box(DOOR_W + REVEAL*2, gapH, 0.07,
                  new THREE.MeshStandardMaterial({color:'#2a2018', roughness:1}),
                  0, gapH/2, 0.035);
  gap.castShadow = false;
  g.add(gap);

  const leaf = paintedSlab(DOOR_W, DOOR_H, 0.10, color);
  leaf.position.set(0, DOOR_H/2, 0.12);
  g.add(leaf); faces.push(leaf.userData.face);

  const pw = DOOR_W - 0.34;
  [[1.34, 2.60], [0.50, 1.58], [1.00, 0.70]].forEach(function(p){
    const panel = paintedSlab(pw, p[0], 0.04, color);
    panel.position.set(0, p[1], 0.19);
    g.add(panel); faces.push(panel.userData.face);
  });

  /* architrave: stands 0.24 off the wall, deeper than any band it meets */
  const CD = 0.24;
  const CH = DOOR_H + REVEAL + CASE_T;
  g.add(box(CASE_T, CH, CD, M.trim, -DOOR_HALF + CASE_T/2, CH/2, CD/2));
  g.add(box(CASE_T, CH, CD, M.trim,  DOOR_HALF - CASE_T/2, CH/2, CD/2));
  g.add(box(DOOR_HALF*2, CASE_T, CD, M.trim, 0, CH - CASE_T/2, CD/2));
  g.add(box(DOOR_HALF*2 + 0.07, 0.06, CD + 0.05, M.trim, 0, CH + 0.03, CD/2 + 0.02));

  const knob = new THREE.Mesh(new THREE.SphereGeometry(0.062, 24, 18), M.brass);
  knob.position.set(DOOR_W/2 - 0.18, 1.42, 0.28); knob.castShadow = true;
  g.add(knob);
  const plate = new THREE.Mesh(new THREE.CylinderGeometry(0.042,0.042,0.02,18), M.brass);
  plate.rotation.x = Math.PI/2; plate.position.set(DOOR_W/2 - 0.18, 1.42, 0.18);
  g.add(plate);

  g.userData.isDoor = true;
  g.userData.name = name;
  g.userData.faces = faces;
  return g;
}

/* ============================================================
   7. WALLS — every horizontal band stops at the architrave
   ============================================================ */
const WAINSCOT_H = 2.02;

function buildWall(width, openings, occ){
  const g = new THREE.Group();

  const pTex = tex(plasterCanvas(Math.min(2048, Math.round(width*120)), 512, occ));
  const pm = new THREE.MeshStandardMaterial({map:pTex, bumpMap:pTex, bumpScale:0.006,
                                             roughnessMap:pTex, roughness:1});
  const plaster = new THREE.Mesh(new THREE.BoxGeometry(width, WALL_H, 0.3), pm);
  plaster.position.set(0, WALL_H/2, -0.15);
  plaster.receiveShadow = true;
  g.add(plaster);

  /* split the wall into runs that die into each architrave */
  function runs(margin){
    const e = [-width/2];
    openings.slice().sort(function(a,b){return a-b;}).forEach(function(x){
      e.push(x - (DOOR_HALF + margin), x + (DOOR_HALF + margin));
    });
    e.push(width/2);
    const out = [];
    for(let i=0;i<e.length;i+=2){
      const a = e[i], b = e[i+1];
      if(b - a > 0.02) out.push([a, b]);
    }
    return out;
  }

  runs(0).forEach(function(r){
    const w = r[1] - r[0], cx = (r[0] + r[1])/2;
    g.add(box(w, WAINSCOT_H, 0.09, M.dado, cx, WAINSCOT_H/2, 0.045));
    g.add(box(w, 0.12, 0.21, M.trim, cx, WAINSCOT_H - 0.06, 0.105));   // chair rail
    g.add(box(w, 0.05, 0.22, M.trim, cx, WAINSCOT_H - 0.14, 0.11));   // rail underside
    g.add(box(w, 0.24, 0.16, M.trim, cx, 0.12, 0.08));                 // skirting
  });

  /* cornice clears the door heads, so it can run the full width */
  g.add(box(width, 0.22, 0.23, M.trim, 0, WALL_H - 0.13, 0.115));
  g.add(box(width, 0.10, 0.34, M.trim, 0, WALL_H - 0.29, 0.17));

  runs(0.16).forEach(function(r){
    const span = r[1] - r[0];
    if(span < 1.05) return;
    const n = Math.max(1, Math.round(span / 2.25));
    const cell = span / n;
    for(let k=0;k<n;k++){
      const f = moulding(Math.min(cell - 0.46, 1.85), WAINSCOT_H - 0.84, 0.08, 0.055, M.trim);
      f.position.set(r[0] + cell*(k+0.5), WAINSCOT_H/2 - 0.10, 0.12);
      g.add(f);
    }
  });

  /* a wall's own mouldings never cast. the side cornice, lit this obliquely,
     was throwing a hard diagonal band clear across the back wall — and every
     shadow these bands owe is already baked into their maps. */
  g.traverse(function(o){ if(o.isMesh) o.castShadow = false; });
  return g;
}

const backDoorX = [-3.6, 0.1, 3.7];
const backWall = buildWall(16, backDoorX, {bottom:0.16, top:0.13, left:0.06, right:0.06});
backWall.position.set(0, 0, BACK_Z);
scene.add(backWall);

/* left wall: world z = SIDE_MID - localX.   right wall: world z = SIDE_MID + localX. */
const sideLocal = { left: SIDE_MID + 5.3, right: -(SIDE_MID + 5.0) };

const leftWall = buildWall(SIDE_LEN, [sideLocal.left], {bottom:0.14, top:0.11, left:0.10});
leftWall.rotation.y = Math.PI/2;
leftWall.position.set(-SIDE_X, 0, SIDE_MID);
scene.add(leftWall);

const rightWall = buildWall(SIDE_LEN, [sideLocal.right], {bottom:0.14, top:0.11, right:0.10});
rightWall.rotation.y = -Math.PI/2;
rightWall.position.set(SIDE_X, 0, SIDE_MID);
scene.add(rightWall);

const floor = new THREE.Mesh(new THREE.PlaneGeometry(44,44), M.carpet);
floor.rotation.x = -Math.PI/2; floor.receiveShadow = true;
scene.add(floor);

const ceiling = new THREE.Mesh(new THREE.PlaneGeometry(44,44), M.ceiling);
ceiling.rotation.x = Math.PI/2; ceiling.position.y = WALL_H;
scene.add(ceiling);

/* carpet-to-skirting occlusion */
(function(){
  const s = 512, c = cvs(s,s), g = c.getContext('2d');
  g.fillStyle = '#000'; g.fillRect(0,0,s,s);
  g.globalCompositeOperation = 'destination-out';
  g.filter = 'blur(26px)'; g.fillStyle = '#fff';
  g.fillRect(34,34,s-68,s-68); g.filter = 'none';
  const m = new THREE.Mesh(new THREE.PlaneGeometry(SIDE_X*2, SIDE_LEN),
    new THREE.MeshBasicMaterial({map:new THREE.CanvasTexture(c), color:0x2b2013,
      transparent:true, opacity:0.44, depthWrite:false}));
  m.rotation.x = -Math.PI/2;
  m.position.set(0, 0.008, SIDE_MID);
  m.renderOrder = 1;
  scene.add(m);
})();

const doors = [];
backDoorX.forEach(function(x,i){
  const d = makeDoor(P.doors[i], 'Door ' + (i+2));
  d.position.set(x, 0, BACK_Z + 0.02);
  scene.add(d); doors.push(d);
});
const dL = makeDoor(P.doors[3], 'Door 1');
dL.rotation.y = Math.PI/2;
dL.position.set(-SIDE_X + 0.02, 0, SIDE_MID - sideLocal.left);
scene.add(dL); doors.push(dL);

const dR = makeDoor(P.doors[4], 'Door 5');
dR.rotation.y = -Math.PI/2;
dR.position.set(SIDE_X - 0.02, 0, SIDE_MID + sideLocal.right);
scene.add(dR); doors.push(dR);

/* ============================================================
   8. FURNITURE — each prop owns its materials so it can fade alone
   ============================================================ */
const props = [];
function registerProp(obj, mats, extra){
  mats.forEach(function(m){
    m.userData.opaqueBase = !m.transparent;
    m.userData.baseOpacity = m.transparent ? m.opacity : 1;
    m.transparent = true;
  });
  const p = Object.assign({obj:obj, mats:mats, o:1, shown:1}, extra || {});
  props.push(p);
  return p;
}

/* ---- two ways to make a shape a box cannot ---------------------------- */

/* a swept tube whose section changes along the run: turned legs, a handset,
   a coiled cord. TubeGeometry lays vertices at centre + unit normal, so the
   section is just a per-ring rescale of that normal. */
function sweep(curve, tubular, radial, radiusAt){
  const g = new THREE.TubeGeometry(curve, tubular, 1, radial, false);
  const pos = g.attributes.position, nrm = g.attributes.normal, c = new THREE.Vector3();
  for(let i=0;i<=tubular;i++){
    const t = i/tubular, r = radiusAt(t);
    curve.getPointAt(t, c);
    for(let j=0;j<=radial;j++){
      const k = i*(radial+1)+j;
      pos.setXYZ(k, c.x + nrm.getX(k)*r, c.y + nrm.getY(k)*r, c.z + nrm.getZ(k)*r);
    }
  }
  pos.needsUpdate = true;
  g.computeVertexNormals();
  return g;
}

/* a stack of rounded-rectangle sections lofted up the y axis — how a moulded
   bakelite case actually reads. rings are superellipses, so the corners are
   genuinely round rather than a few bevel facets, and the grid is indexed so
   the normals come out smooth the whole way round.
   rings are [halfWidth, halfDepth, y, squareness]. */
function loft(rings, seg){
  const rows = rings.length, pos = [], uv = [], idx = [];
  for(let i=0;i<rows;i++){
    const R = rings[i], e = 2/(R[3] === undefined ? 5 : R[3]);
    for(let j=0;j<=seg;j++){
      const t = j/seg*Math.PI*2, ct = Math.cos(t), st = Math.sin(t);
      pos.push(R[0]*Math.sign(ct)*Math.pow(Math.abs(ct), e), R[2],
               R[1]*Math.sign(st)*Math.pow(Math.abs(st), e));
      uv.push(j/seg, i/(rows-1));
    }
  }
  for(let i=0;i<rows-1;i++) for(let j=0;j<seg;j++){
    const a = i*(seg+1)+j, b = a+seg+1;
    idx.push(a, b, a+1, a+1, b, b+1);
  }
  const g = new THREE.BufferGeometry();
  g.setAttribute('position', new THREE.Float32BufferAttribute(pos,3));
  g.setAttribute('uv', new THREE.Float32BufferAttribute(uv,2));
  g.setIndex(idx);
  g.computeVertexNormals();
  return g;
}

/* a turned profile, given as [radius, height] pairs read bottom to top */
function turned(profile, segs){
  return new THREE.LatheGeometry(profile.map(function(p){
    return new THREE.Vector2(p[0], p[1]);
  }), segs || 56);
}

/* ---- what the furniture is made of ------------------------------------ */

/* close-grain walnut: cathedral figure, ray fleck, and the open pores that
   keep a french-polished top from reading as moulded plastic */
function walnutCanvas(){
  const w = 1024, h = 1024, c = cvs(w,h), g = c.getContext('2d');
  const base = '#4a2e1e';
  g.fillStyle = base; g.fillRect(0,0,w,h);
  blotch(g, w, h, base, 34, 1.0, 0.40);
  for(let i=0;i<12;i++){                                   /* broad tonal bands */
    const y = Math.random()*h, hh = 50 + Math.random()*190;
    const d = g.createLinearGradient(0, y-hh, 0, y+hh);
    const c = shift(base, (Math.random()-0.5)*0.13, (Math.random()-0.5)*0.06);
    d.addColorStop(0, rgba(c,0)); d.addColorStop(0.5, rgba(c,0.5)); d.addColorStop(1, rgba(c,0));
    g.fillStyle = d; g.fillRect(0, y-hh, w, hh*2);
  }
  for(let i=0;i<340;i++){                                  /* growth rings */
    const y = Math.random()*h;
    const amp = 14 + Math.pow(Math.random(), 2.2)*250;     /* mostly straight, some cathedral */
    g.globalAlpha = 0.07 + Math.random()*0.30;
    g.strokeStyle = shift(base, (Math.random()-0.5)*0.26, (Math.random()-0.5)*0.12);
    g.lineWidth = 0.6 + Math.random()*3.4;
    g.beginPath(); g.moveTo(-12, y);
    g.bezierCurveTo(w*0.26, y - amp,
                    w*0.64, y + amp*0.78,
                    w+12,   y + (Math.random()-0.5)*70);
    g.stroke();
  }
  for(let i=0;i<900;i++){                                  /* ray fleck */
    g.globalAlpha = 0.05 + Math.random()*0.10;
    g.strokeStyle = shift(base, 0.11);
    g.lineWidth = 0.7;
    const x = Math.random()*w, y = Math.random()*h;
    g.beginPath(); g.moveTo(x,y);
    g.lineTo(x + 6 + Math.random()*22, y + (Math.random()-0.5)*3); g.stroke();
  }
  g.globalAlpha = 1;
  for(let i=0;i<2600;i++){                                 /* open pores */
    g.fillStyle = 'rgba(26,14,7,' + (0.05 + Math.random()*0.20).toFixed(3) + ')';
    g.fillRect(Math.random()*w, Math.random()*h, 1.4 + Math.random()*2.2, 1.0);
  }
  return c;
}

/* brass, still showing the lathe's circular tooling and a little tarnish */
function brassCanvas(){
  const w = 512, h = 512, c = cvs(w,h), g = c.getContext('2d');
  const base = '#c8a765';
  g.fillStyle = base; g.fillRect(0,0,w,h);
  blotch(g, w, h, shift(base,-0.12,0.06), 26, 0.9, 0.34);
  for(let i=0;i<520;i++){
    g.globalAlpha = 0.05 + Math.random()*0.18;
    g.strokeStyle = shift(base, (Math.random()-0.5)*0.26, (Math.random()-0.5)*0.12);
    g.lineWidth = 0.5 + Math.random()*2.2;
    const y = Math.random()*h;
    g.beginPath(); g.moveTo(0,y); g.lineTo(w, y + (Math.random()-0.5)*4); g.stroke();
  }
  g.globalAlpha = 1;
  speckle(g, w, h, 1100, 0.06);
  return c;
}

/* shade cloth seen from outside: warp, weft, slubs, and the vertical seam */
function linenCanvas(){
  const w = 512, h = 256, c = cvs(w,h), g = c.getContext('2d');
  const base = '#b0574a';
  g.fillStyle = base; g.fillRect(0,0,w,h);
  blotch(g, w, h, base, 28, 0.8, 0.26);
  g.globalAlpha = 0.10;
  for(let x=0;x<w;x+=2){
    g.strokeStyle = shift(base, (Math.random()-0.5)*0.20);
    g.lineWidth = 1; g.beginPath(); g.moveTo(x,0); g.lineTo(x,h); g.stroke();
  }
  for(let y=0;y<h;y+=2){
    g.strokeStyle = shift(base, (Math.random()-0.5)*0.16);
    g.lineWidth = 1; g.beginPath(); g.moveTo(0,y); g.lineTo(w,y); g.stroke();
  }
  g.globalAlpha = 1;
  for(let i=0;i<170;i++){                                  /* slubs */
    g.fillStyle = rgba(shift(base, 0.10), 0.20 + Math.random()*0.22);
    g.fillRect(Math.random()*w, Math.random()*h, 3 + Math.random()*9, 1.3);
  }
  g.fillStyle = rgba(shift(base,-0.12), 0.45);             /* the seam */
  g.fillRect(w*0.5 - 1.5, 0, 3, h);
  return c;
}

/* how much light the cloth lets through: hot just above the bulb, dying at
   both rims. v runs 0 at the bottom edge of the shade. */
function shadeGlowCanvas(){
  const w = 32, h = 256, c = cvs(w,h), g = c.getContext('2d');
  const d = g.createLinearGradient(0,h,0,0);
  d.addColorStop(0.00,'#3a2a1a');
  d.addColorStop(0.07,'#e2a765');
  d.addColorStop(0.34,'#ffd9a6');
  d.addColorStop(0.74,'#7a5836');
  d.addColorStop(1.00,'#211809');
  g.fillStyle = d; g.fillRect(0,0,w,h);
  return c;
}

/* moulded bakelite: flow lines from the press, and a buffed-out surface */
function bakeliteCanvas(color){
  const w = 512, h = 512, c = cvs(w,h), g = c.getContext('2d');
  g.fillStyle = color; g.fillRect(0,0,w,h);
  blotch(g, w, h, color, 34, 0.7, 0.20);
  g.globalAlpha = 0.07;
  for(let i=0;i<70;i++){                                   /* mould flow */
    g.strokeStyle = shift(color, (Math.random()-0.5)*0.18);
    g.lineWidth = 3 + Math.random()*16;
    const y = Math.random()*h;
    g.beginPath(); g.moveTo(0, y);
    g.bezierCurveTo(w*0.3, y+(Math.random()-0.5)*70, w*0.7, y+(Math.random()-0.5)*70, w, y+(Math.random()-0.5)*40);
    g.stroke();
  }
  g.globalAlpha = 1;
  speckle(g, w, h, 1500, 0.045);
  return c;
}

/* the dial: finger wheel over a printed number ring */
function dialCanvas(){
  const s = 512, R = s/2, c = cvs(s,s), g = c.getContext('2d');
  g.fillStyle = '#ece5d6'; g.beginPath(); g.arc(R,R,R*0.995,0,Math.PI*2); g.fill();
  g.fillStyle = 'rgba(30,24,16,.16)';
  g.beginPath(); g.arc(R,R,R*0.995,0,Math.PI*2); g.arc(R,R,R*0.86,0,Math.PI*2,true); g.fill();
  g.fillStyle = '#232120'; g.beginPath(); g.arc(R,R,R*0.79,0,Math.PI*2); g.fill();

  const label = ['1','2','3','4','5','6','7','8','9','0'];
  g.textAlign = 'center'; g.textBaseline = 'middle';
  for(let i=0;i<10;i++){
    const a = (-96 + i*29.5) * Math.PI/180;
    const hx = R + Math.cos(a)*R*0.565, hy = R + Math.sin(a)*R*0.565;
    g.fillStyle = '#0b0b0a';
    g.beginPath(); g.arc(hx,hy,R*0.112,0,Math.PI*2); g.fill();
    g.strokeStyle = 'rgba(255,255,255,.13)'; g.lineWidth = R*0.016;
    g.beginPath(); g.arc(hx,hy,R*0.112,0,Math.PI*2); g.stroke();
    g.fillStyle = '#2b2822';
    g.font = '600 ' + Math.round(R*0.145) + 'px Helvetica, Arial, sans-serif';
    g.fillText(label[i], R + Math.cos(a)*R*0.915, R + Math.sin(a)*R*0.915);
  }
  g.fillStyle = '#171614'; g.beginPath(); g.arc(R,R,R*0.215,0,Math.PI*2); g.fill();
  g.fillStyle = '#3a3733'; g.beginPath(); g.arc(R,R,R*0.06,0,Math.PI*2); g.fill();
  return c;
}

const walnutTex = tex(walnutCanvas());
const brassTex  = tex(brassCanvas());
const linenTex  = tex(linenCanvas());
const glowTex   = tex(shadeGlowCanvas());

const TABLE = new THREE.Vector3(-4.30, 0, -5.05);

/* ---- the table: a walnut tripod on a turned pedestal ------------------- */
const walnutM = new THREE.MeshPhysicalMaterial({
  map:walnutTex, bumpMap:walnutTex, bumpScale:0.0018,
  roughness:0.44, metalness:0, clearcoat:0.38, clearcoatRoughness:0.30
});
const tBrassM = new THREE.MeshStandardMaterial({
  map:brassTex, bumpMap:brassTex, bumpScale:0.002, color:'#a98c52',
  roughness:0.34, metalness:0.9
});

const table = new THREE.Group();

/* top, with an ogee edge turned into the profile rather than faked with a torus */
const top = new THREE.Mesh(turned([
  [0.000,0.000],[0.760,0.000],[0.830,0.004],[0.868,0.014],[0.888,0.030],
  [0.893,0.046],[0.884,0.060],[0.862,0.070],[0.832,0.076],[0.790,0.078],
  [0.000,0.078]
], 72), walnutM);
top.position.y = 0.937;
(function(g){                       /* grain runs across the top, not around it */
  const p = g.attributes.position, uv = [];
  for(let i=0;i<p.count;i++) uv.push(p.getX(i)/2.1 + 0.5, p.getZ(i)/2.1 + 0.5);
  g.setAttribute('uv', new THREE.Float32BufferAttribute(uv, 2));
})(top.geometry);
table.add(top);

/* pedestal */
table.add(new THREE.Mesh(turned([
  [0.000,0.150],[0.212,0.150],[0.224,0.166],[0.210,0.190],[0.166,0.226],
  [0.129,0.276],[0.112,0.336],[0.127,0.400],[0.163,0.462],[0.187,0.520],
  [0.190,0.576],[0.171,0.632],[0.132,0.686],[0.104,0.730],[0.098,0.768],
  [0.117,0.800],[0.153,0.830],[0.168,0.858],[0.150,0.882],[0.128,0.902],
  [0.292,0.906],[0.302,0.918],[0.296,0.936],[0.000,0.936]
], 48), walnutM));

/* three cabriole legs: knee out, ankle in, pad foot on a brass toe cap */
for(let i=0;i<3;i++){
  const a  = (i/3)*Math.PI*2 + 0.62;
  const ux = Math.cos(a), uz = Math.sin(a);
  const path = new THREE.CatmullRomCurve3([
    new THREE.Vector3(ux*0.10, 0.290, uz*0.10),
    new THREE.Vector3(ux*0.31, 0.198, uz*0.31),
    new THREE.Vector3(ux*0.53, 0.118, uz*0.53),
    new THREE.Vector3(ux*0.71, 0.068, uz*0.71),
    new THREE.Vector3(ux*0.81, 0.030, uz*0.81)
  ]);
  table.add(new THREE.Mesh(sweep(path, 40, 14, function(t){
    return 0.090 - 0.050*t*t - 0.012*Math.sin(t*Math.PI);
  }), walnutM));
  const cap = new THREE.Mesh(new THREE.CylinderGeometry(0.040,0.046,0.030,18), tBrassM);
  cap.position.set(ux*0.815, 0.015, uz*0.815);
  table.add(cap);
}

table.traverse(function(o){ if(o.isMesh){ o.castShadow = true; o.receiveShadow = true; } });
table.position.copy(TABLE);
scene.add(table);
const tableShadow = contact(2.15, 0.30, TABLE.x, TABLE.z);
scene.add(tableShadow);
registerProp(table, [walnutM, tBrassM]);
registerProp(tableShadow, [tableShadow.material]);

